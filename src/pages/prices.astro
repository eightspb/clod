---
import Layout from '../layouts/Layout.astro'
import { Prices } from '../components/pages/Prices.jsx'
import { BreadcrumbNav } from '../components/BreadcrumbNav.jsx'
import { db, Service } from 'astro:db'

const services = await db.select().from(Service);
---

<Layout
  title="Цены на услуги — Клиника Одинцова в Санкт-Петербурге"
  description="Честные фиксированные цены без скрытых доплат. Прайс-лист на маммологию, гинекологию, эндокринологию и неврологию. ВАБ под ключ от 35 000 ₽."
  keywords="цены клиника Одинцова, стоимость ВАБ СПб, цена маммолог СПб, прайс гинеколог СПб, сколько стоит ВАБ, стоимость удаления фиброаденомы СПб"
>
  <BreadcrumbNav items={[{ label: 'Цены' }]} />
  <Prices servicesData={services} client:load />
</Layout>
