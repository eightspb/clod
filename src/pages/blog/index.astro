---
import { getCollection } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import { BreadcrumbNav } from '../../components/BreadcrumbNav.jsx'

function normalizeImageUrl(image) {
  if (!image) return '/images/og-default.jpg'
  if (image.startsWith('http://') || image.startsWith('https://')) return image
  if (image.startsWith('/')) return image
  const normalizedImage = image.replace(/^\/?/, '')
  return normalizedImage.startsWith('images/')
    ? `/${normalizedImage}`
    : `/images/${normalizedImage}`
}

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
)

const CATEGORY_SOFT_COLORS = {
  'Маммология':       'clay-card-soft-mint',
  'Диагностика':      'clay-card-soft-blue',
  'Эндокринология':   'clay-card-soft-peach',
  'Гинекология':      'clay-card-soft-lavender',
  'Нутрициология':    'clay-card-soft-lavender',
  'Неврология':       'clay-card-soft-blue',
  'События клиники':  'clay-card-soft-peach',
  'Клинические случаи': 'clay-card-soft-mint',
  'Видео':            'clay-card-soft-blue',
}

const CATEGORY_ACCENT = {
  'Маммология':       'text-emerald-700 bg-emerald-50/90',
  'Диагностика':      'text-sky-700 bg-sky-50/90',
  'Эндокринология':   'text-orange-700 bg-orange-50/90',
  'Гинекология':      'text-violet-700 bg-violet-50/90',
  'Нутрициология':    'text-violet-700 bg-violet-50/90',
  'Неврология':       'text-sky-700 bg-sky-50/90',
  'События клиники':  'text-orange-700 bg-orange-50/90',
  'Клинические случаи': 'text-emerald-700 bg-emerald-50/90',
  'Видео':            'text-sky-700 bg-sky-50/90',
}

const FALLBACK_COLORS = [
  'clay-card-soft-mint',
  'clay-card-soft-peach',
  'clay-card-soft-blue',
  'clay-card-soft-lavender',
]


const ALL_CATEGORIES = ['Все', 'Маммология', 'Гинекология', 'Эндокринология', 'Нутрициология', 'Диагностика', 'События клиники', 'Клинические случаи', 'Видео']

const TV_VIDEOS = [
  {
    title: 'Одинцов о ВАБ на телевидении',
    desc: 'Интервью о вакуумно-аспирационной биопсии и маршруте пациентки.',
    channel: 'ТВ-эфир',
    date: '2025',
  },
  {
    title: 'Маммология без мифов',
    desc: 'Комментарий врача о распространённых мифах и клинической практике.',
    channel: 'ТВ-эфир',
    date: '2025',
  },
  {
    title: 'Гормоны под контролем',
    desc: 'Как работает щитовидная железа и когда имеет смысл обследование.',
    channel: 'ТВ-эфир',
    date: '2025',
  },
  {
    title: 'Женское здоровье после 40',
    desc: 'Как меняются задачи профилактики и наблюдения в зрелом возрасте.',
    channel: 'ТВ-эфир',
    date: '2025',
  }
]

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Блог Клиники Одинцова',
  description: 'Статьи о маммологии, гинекологии, эндокринологии и нутрициологии от врачей клиники',
  url: 'https://odintsovclinic.ru/blog',
  numberOfItems: posts.length,
  itemListElement: posts.map((post, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: `https://odintsovclinic.ru/blog/${post.slug}`,
    name: post.data.title,
  })),
  publisher: {
    '@type': 'MedicalBusiness',
    name: 'Клиника Одинцова',
    url: 'https://odintsovclinic.ru',
  },
  spatialCoverage: {
    '@type': 'Place',
    name: 'Санкт-Петербург',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Санкт-Петербург',
      addressRegion: 'Санкт-Петербург',
      addressCountry: 'RU',
    },
  },
}
---

<Layout
  title="Блог и клинические разборы | Клиника Одинцова"
  description="Статьи, клинические разборы и ответы врачей Клиники Одинцова. Материалы для пациентов из разных регионов России, с мягким локальным маршрутом в Санкт-Петербурге."
  keywords="блог клиники, клинические разборы, статьи о маммологии, статьи о гинекологии, статьи об эндокринологии, диагностика"
  canonicalUrl="https://odintsovclinic.ru/blog"
>
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />

  <BreadcrumbNav items={[{ label: 'Блог' }]} />

  <div class="container-clay pb-20">

    <div class="mb-10">
      <h1 class="text-4xl sm:text-5xl md:text-6xl heading-display text-clay-dark mb-4">
        Блог и клинические разборы
      </h1>
      <p class="text-clay-muted text-lg md:text-xl max-w-3xl leading-relaxed">
        Статьи, клинические случаи и комментарии врачей. Разбираем медицинские темы спокойно и точно, без лишнего рекламного тона.
      </p>
      <p class="text-sm text-clay-muted mt-3 max-w-3xl">
        Блог полезен читателям из любого региона России. Если вы в Санкт-Петербурге, в финальных блоках подскажем очную маршрутизацию и запись на приём.
      </p>
    </div>

    {/* Видео с ТВ - Карусель */}
    <section class="mb-16 relative">
      <div class="flex items-center justify-between mb-6">
        <div class="flex items-center gap-3">
          <div class="icon-circle-blue shadow-lg shadow-sky-500/20">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="23 7 16 12 23 17 23 7"/>
              <rect x="1" y="5" width="15" height="14" rx="2" ry="2"/>
            </svg>
          </div>
          <h2 class="text-2xl sm:text-3xl heading-serif text-clay-dark">Выступления врачей в медиа</h2>
        </div>
        <div class="hidden sm:flex gap-2">
          {/* Кнопки скролла */}
          <button type="button" id="prev-video-btn" aria-label="Предыдущее видео" class="w-8 h-8 rounded-full flex items-center justify-center bg-white shadow-sm border border-gray-100 text-clay-muted hover:text-clay-teal hover:border-clay-teal transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-clay-mint/40 focus-visible:ring-offset-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
          </button>
          <button type="button" id="next-video-btn" aria-label="Следующее видео" class="w-8 h-8 rounded-full flex items-center justify-center bg-white shadow-sm border border-gray-100 text-clay-teal hover:bg-clay-teal hover:text-white transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-clay-mint/40 focus-visible:ring-offset-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
        </div>
      </div>
      
      {/* Скроллируемый контейнер (карусель) */}
      <div id="video-carousel" class="flex gap-5 overflow-x-auto snap-x snap-mandatory pb-6 pt-2 [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden -mx-4 px-4 sm:mx-0 sm:px-0 scroll-smooth">
        {TV_VIDEOS.map((video) => (
          <div class="clay-card-soft-blue clay-card p-6 flex flex-col gap-4 min-w-[280px] w-[85%] sm:w-[350px] lg:w-[400px] snap-center flex-shrink-0 hover:-translate-y-0.5 transition-transform duration-300">
            <div class="flex items-center justify-between mb-1">
              <span class="text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full text-sky-700 bg-sky-100/80">
                {video.channel}
              </span>
              <span class="text-xs font-medium text-clay-muted bg-white/60 px-2.5 py-1 rounded-md">{video.date}</span>
            </div>
            
            <div class="w-full aspect-video rounded-2xl flex items-center justify-center relative overflow-hidden group cursor-pointer shadow-inner bg-gradient-to-br from-sky-100/50 to-sky-50/20 border border-sky-100/50">
              <div class="absolute inset-0 bg-sky-900/5 group-hover:bg-sky-900/10 transition-colors duration-300"></div>
              <div class="text-center relative z-10 transform group-hover:scale-110 transition-transform duration-300">
                <div class="w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-3 shadow-lg shadow-sky-500/20 backdrop-blur-sm" style="background: rgba(255,255,255,0.9);">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#0284c7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-1">
                    <polygon points="5 3 19 12 5 21 5 3"/>
                  </svg>
                </div>
                <p class="text-xs font-semibold text-sky-800 bg-white/80 px-3 py-1 rounded-full backdrop-blur-md shadow-sm">Видео скоро появится</p>
              </div>
            </div>
            
            <div>
              <h3 class="font-bold text-clay-text text-lg leading-snug mb-2">{video.title}</h3>
              <p class="text-sm text-clay-muted leading-relaxed">{video.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    {/* Категории */}
    <div class="flex flex-wrap gap-2.5 mb-12 justify-center md:justify-start" id="category-filters">
      {ALL_CATEGORIES.map((cat, i) => (
        <button
          type="button"
          data-filter={cat}
          aria-pressed={i === 0}
          class={`category-filter-btn inline-flex items-center px-4 py-2 rounded-full text-sm font-semibold cursor-pointer transition-all hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-clay-mint/40 focus-visible:ring-offset-2 ${
            i === 0 ? 'active-filter' : ''
          }`}
        >
          {cat}
        </button>
      ))}
    </div>

    {/* Статьи */}
    <section class="mb-16">
      <h2 class="text-2xl sm:text-3xl heading-serif text-clay-dark mb-8">Статьи и клинические случаи</h2>
      {posts.length === 0 ? (
        <div class="p-12 text-center clay-card clay-card-soft-mint">
          <p class="text-clay-dark font-medium text-lg">Статьи скоро появятся.</p>
        </div>
      ) : (
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post, index) => {
            const cardColor = CATEGORY_SOFT_COLORS[post.data.category] ?? FALLBACK_COLORS[index % FALLBACK_COLORS.length]
            const accentClass = CATEGORY_ACCENT[post.data.category] ?? 'text-clay-teal bg-teal-50/90'
            const formattedDate = post.data.publishDate.toLocaleDateString('ru-RU', {
              day: 'numeric',
              month: 'long',
              year: 'numeric',
            })
            
            return (
              <a
                href={`/blog/${post.slug}`}
                data-post-card
                data-category={post.data.category}
                class={`${cardColor} clay-card flex flex-col p-0 overflow-hidden hover:shadow-xl hover:-translate-y-1 transition-all duration-300 no-underline group border border-white/40`}
              >
                {/* Изображение карточки */}
                <div class="w-full h-52 overflow-hidden relative bg-gray-100">
                  <img
                    src={normalizeImageUrl(post.data.image)}
                    alt={post.data.imageAlt || post.data.title}
                    loading="lazy"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-clay-dark/60 via-transparent to-transparent opacity-80"></div>
                  <div class="absolute bottom-4 left-4 flex items-center gap-2">
                    <span class={`text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full shadow-sm backdrop-blur-md bg-white/95 ${accentClass}`}>
                      {post.data.category}
                    </span>
                  </div>
                </div>
                
                {/* Текстовая часть карточки */}
                <div class="p-6 md:p-7 flex flex-col flex-1">
                  <div class="flex items-center gap-3 mb-4">
                    <span class="text-xs font-semibold text-clay-muted flex items-center gap-1.5 bg-white/50 px-2 py-1 rounded-md">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                      {formattedDate}
                    </span>
                    {post.data.readingTime && (
                      <span class="text-xs font-semibold text-clay-muted flex items-center gap-1.5 bg-white/50 px-2 py-1 rounded-md">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        {post.data.readingTime} мин
                      </span>
                    )}
                  </div>
                  
                  <h2 class="text-xl font-extrabold text-clay-dark mb-3 leading-snug line-clamp-3 group-hover:text-clay-teal transition-colors">
                    {post.data.title}
                  </h2>
                  
                  <p class="text-sm text-clay-text mb-6 line-clamp-3 leading-relaxed opacity-90">
                    {post.data.description}
                  </p>
                  
                  <div class="mt-auto pt-5 border-t border-black/5 flex items-center justify-between">
                    <span class="text-sm font-bold text-clay-teal group-hover:translate-x-1.5 transition-transform duration-300 flex items-center gap-1.5">
                      Читать статью
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                    </span>
                  </div>
                </div>
              </a>
            )
          })}
        </div>
      )}
    </section>

    {/* CTA в онлайн-сервис клиники */}
    <div class="grid gap-6 md:grid-cols-2 mb-10">
      <div class="clay-card-soft-mint clay-card p-8 md:p-10 text-center flex flex-col items-center justify-center hover:shadow-lg transition-shadow duration-300">
        <div class="w-16 h-16 rounded-full bg-white/60 flex items-center justify-center mb-5 text-emerald-600 shadow-sm">
           <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </div>
        <h2 class="text-2xl font-bold text-clay-dark mb-3">Личный кабинет пациента</h2>
        <p class="text-clay-muted mb-8 text-base leading-relaxed max-w-sm">
          Если вы уже пользуетесь внешним сервисом МедТочка, здесь можно авторизоваться и перейти к своим данным.
        </p>
        <a href="https://app.medtochka.ru/authorization/?preselected_country=RU" class="btn-clay-primary inline-flex items-center gap-2.5 px-8 py-3.5 text-base w-full sm:w-auto justify-center">
          Открыть МедТочку
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
      
      <div class="clay-card p-8 md:p-10 text-center flex flex-col items-center justify-center hover:shadow-lg transition-shadow duration-300 relative overflow-hidden">
        <div class="absolute -right-6 -top-6 w-32 h-32 bg-sky-50 rounded-full blur-2xl opacity-40"></div>
        <div class="w-16 h-16 rounded-full bg-sky-50 flex items-center justify-center mb-5 text-sky-600 shadow-sm">
           <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
        </div>
        <h2 class="text-2xl font-bold text-clay-dark mb-3">Нужна очная консультация?</h2>
        <p class="text-clay-muted mb-8 text-base leading-relaxed max-w-sm relative z-10">
          Если вы в Санкт-Петербурге, подскажем профильного специалиста и удобное время визита.
        </p>
        <button type="button" data-booking-btn="true" class="btn-clay-secondary inline-flex items-center gap-2.5 px-8 py-3.5 text-base w-full sm:w-auto justify-center relative z-10">
          Записаться на приём
        </button>
      </div>
    </div>

  </div>

  <style is:global>
    .category-filter-btn {
      background: rgba(255, 255, 255, 0.82);
      color: #27453f;
      border: 1px solid rgba(47, 143, 124, 0.18);
      box-shadow: 0 8px 18px rgba(36, 55, 51, 0.04);
    }
    .category-filter-btn.active-filter {
      background: #27453f;
      color: white;
      border-color: #27453f;
    }
    .category-filter-btn:focus-visible {
      outline: none;
      box-shadow: 0 0 0 3px rgba(47, 143, 124, 0.22);
    }
  </style>

  <script>
    function setupBlogInteractions() {
      // Фильтрация категорий блога
      const filterBtns = document.querySelectorAll('.category-filter-btn');
      const postCards = document.querySelectorAll('[data-post-card]');

      if (filterBtns.length > 0 && postCards.length > 0) {
        filterBtns.forEach(btn => {
          btn.onclick = () => {
            // Убираем активный класс у всех
            filterBtns.forEach(b => b.classList.remove('active-filter'));
            filterBtns.forEach(b => b.setAttribute('aria-pressed', 'false'));
            // Добавляем нажатой кнопке
            btn.classList.add('active-filter');
            btn.setAttribute('aria-pressed', 'true');

            const selectedCategory = btn.getAttribute('data-filter');

            // Фильтруем карточки
            postCards.forEach(card => {
              const cardCategory = card.getAttribute('data-category');
              if (selectedCategory === 'Все' || cardCategory === selectedCategory) {
                // Карточки используют flex
                card.style.display = 'flex';
              } else {
                card.style.display = 'none';
              }
            });
          };
        });
      }

      // Карусель видео
      const videoCarousel = document.getElementById('video-carousel');
      const prevBtn = document.getElementById('prev-video-btn');
      const nextBtn = document.getElementById('next-video-btn');

      if (videoCarousel && prevBtn && nextBtn) {
        prevBtn.onclick = () => {
          const cardWidth = videoCarousel.firstElementChild?.clientWidth || 350;
          const gap = 20;
          videoCarousel.scrollBy({ left: -(cardWidth + gap), behavior: 'smooth' });
        };

        nextBtn.onclick = () => {
          const cardWidth = videoCarousel.firstElementChild?.clientWidth || 350;
          const gap = 20;
          videoCarousel.scrollBy({ left: (cardWidth + gap), behavior: 'smooth' });
        };
      }
    }

    // Запускаем при загрузке
    setupBlogInteractions();
    
    // Поддержка Astro View Transitions (на всякий случай)
    document.addEventListener('astro:page-load', setupBlogInteractions);
  </script>
</Layout>
