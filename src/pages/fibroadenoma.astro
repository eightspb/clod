---
import Layout from '../layouts/Layout.astro'
import ServiceArticles from '../components/ServiceArticles.astro'
import { Fibroadenoma, FIBROADENOMA_FAQ } from '../components/pages/Fibroadenoma.jsx'
import { BreadcrumbNav } from '../components/BreadcrumbNav.jsx'
import { generateFaqSchema } from '../utils/schema.js'

const conditionSchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalCondition',
  '@id': 'https://odintsovclinic.ru/fibroadenoma#condition',
  url: 'https://odintsovclinic.ru/fibroadenoma',
  name: 'Фиброаденома молочной железы',
  alternateName: 'Fibroadenoma',
  description: 'Доброкачественное опухолевидное образование молочной железы из железистой и соединительной ткани. Чаще встречается у женщин 15-35 лет.',
  associatedAnatomy: {
    '@type': 'AnatomicalStructure',
    name: 'Молочная железа',
  },
  possibleTreatment: [
    {
      '@type': 'MedicalTherapy',
      name: 'Динамическое наблюдение',
    },
    {
      '@type': 'MedicalTherapy',
      name: 'Вакуумная аспирационная биопсия (ВАБ)',
    },
    {
      '@type': 'MedicalTherapy',
      name: 'Хирургическое удаление',
    },
  ],
}

const faqSchema = generateFaqSchema(FIBROADENOMA_FAQ)
---

<Layout
  pageType="MedicalWebPage"
  mainEntityId="https://odintsovclinic.ru/fibroadenoma#condition"
  title="Фиброаденома молочной железы: лечение и удаление в СПб"
  description="Консультация маммолога при фиброаденоме в Санкт-Петербурге. Разбор УЗИ, наблюдение или удаление по показаниям, ВАБ и второе мнение. Клиника Одинцова."
  keywords="фиброаденома молочной железы, лечение фиброаденомы СПб, ВАБ фиброаденома, маммолог Санкт-Петербург, удаление фиброаденомы, Приморский район"
  ogImage="/images/og/fibroadenoma.webp"
>
  <script type="application/ld+json" set:html={JSON.stringify(conditionSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <BreadcrumbNav items={[{ label: 'Маммология', href: '/mammology' }, { label: 'Фиброаденома' }]} />
  <Fibroadenoma client:idle />
  <ServiceArticles articles={[
    { slug: 'chto-takoe-fibroadenoma', title: 'Фиброаденома молочной железы: что важно знать' },
    { slug: 'fibroadenoma-chastye-voprosy', title: 'Фиброаденома: ответы на частые вопросы' },
    { slug: 'vab-ili-operatsiya', title: 'ВАБ или операция при фиброаденоме: как выбрать' },
  ]} />
</Layout>
