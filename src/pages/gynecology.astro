---
export const prerender = false
import Layout from '../layouts/Layout.astro'
import { Gynecology } from '../components/pages/Gynecology.jsx'
import { BreadcrumbNav } from '../components/BreadcrumbNav.jsx'
import { db, Service } from 'astro:db'
import { eq } from 'astro:db'

const services = await db.select().from(Service).where(eq(Service.direction, 'Гинекология'));

const specialtySchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalClinic',
  name: 'Клиника Одинцова - Гинекология',
  medicalSpecialty: 'Gynecology',
  availableService: {
    '@type': 'MedicalProcedure',
    name: 'Гинекологический осмотр и УЗИ малого таза',
  },
  isPartOf: { '@type': 'MedicalBusiness', name: 'Клиника Одинцова' },
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'пр. Богатырский, д. 22, к. 1',
    addressLocality: 'Санкт-Петербург',
    postalCode: '197374',
    addressRegion: 'Санкт-Петербург',
    addressCountry: 'RU',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 60.0028,
    longitude: 30.2153,
  },
}
---

<Layout
  title="Гинекология в Санкт-Петербурге - приём без боли и гипердиагностики | Клиника Одинцова"
  description="Бережная гинекология без боли и гипердиагностики. Осмотр, УЗИ малого таза и анализы за один приём. Результаты через 24 часа."
  keywords="гинеколог Санкт-Петербург, гинеколог СПб, гинеколог Комендантский проспект, гинеколог Старая Деревня, УЗИ малого таза СПб, гинеколог-эндокринолог СПб, женское здоровье СПб"
>
  <script type="application/ld+json" set:html={JSON.stringify(specialtySchema)} />
  <BreadcrumbNav items={[{ label: 'Гинекология' }]} />
  <Gynecology servicesData={services} />
</Layout>
