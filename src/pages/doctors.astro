---
import Layout from '../layouts/Layout.astro'
import { Doctors } from '../components/pages/Doctors.jsx'
import { BreadcrumbNav } from '../components/BreadcrumbNav.jsx'
import { DOCTORS } from '../lib/doctors-data.js'

const doctorsSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Врачи Клиники Одинцова',
  description: 'Онкологи-маммологи, гинекологи, эндокринологи и нутрициологи клиники Одинцова в Санкт-Петербурге',
  url: 'https://odintsovclinic.ru/doctors',
  numberOfItems: DOCTORS.length,
  itemListElement: DOCTORS.map((doctor, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: `https://odintsovclinic.ru/doctors/${doctor.slug}`,
    name: doctor.name,
  })),
}
---

<Layout
  title="Врачи клиники Одинцова в СПб — специальности и запись"
  description="Маммологи, гинекологи, эндокринологи и нутрициологи клиники Одинцова в Санкт-Петербурге. Образование, опыт, профили врачей и запись на приём."
  keywords="врачи клиника Одинцова, онколог-маммолог СПб, гинеколог СПб, эндокринолог СПб, нутрициолог СПб, врачи Санкт-Петербург, Приморский район"
  ogImage="/images/og/doctors.webp"
>
  <script type="application/ld+json" set:html={JSON.stringify(doctorsSchema)} />
  <div class="hidden md:block">
    <BreadcrumbNav items={[{ label: 'Доктора' }]} />
  </div>
  <Doctors client:idle />
</Layout>
