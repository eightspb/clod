---
import Layout from '../layouts/Layout.astro'
import { BreadcrumbNav } from '../components/BreadcrumbNav.jsx'
import { FaqSection } from '../components/FaqSection.jsx'
import { TaxFormRequestForm } from '../components/TaxFormRequestForm.jsx'
import { PHONE_DISPLAY, PHONE_NUMBER } from '../lib/contacts.js'
import { CheckCircle2, FileText, Phone, ShieldCheck } from 'lucide-react'

const FAQ_ITEMS = [
  {
    question: 'Какие данные нужны для заявки?',
    answer: 'Нужны ФИО и дата рождения пациента, ФИО, дата рождения и ИНН налогоплательщика, а также контактные данные для связи.',
  },
  {
    question: 'Куда придет справка?',
    answer: 'После проверки заявки сотрудники клиники подготовят справку для налоговой инспекции и свяжутся с вами по указанному email или телефону.',
  },
  {
    question: 'Можно ли подать заявку, если пациент и налогоплательщик разные люди?',
    answer: 'Да, форма как раз позволяет отдельно указать данные пациента и налогоплательщика.',
  },
]

const taxFormSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Форма запроса справки для налогового вычета',
  description: 'Онлайн-форма Клиники Одинцова для запроса справки в налоговую инспекцию.',
  url: 'https://odintsovclinic.ru/tax-form',
  inLanguage: 'ru-RU',
  isPartOf: {
    '@type': 'WebSite',
    name: 'Клиника Одинцова',
    url: 'https://odintsovclinic.ru',
  },
}
---

<Layout
  title="Форма для налоговой справки | Клиника Одинцова"
  description="Заполните онлайн-форму для получения справки в налоговую инспекцию. Укажите данные пациента, налогоплательщика и контакты для связи."
  keywords="справка для налоговой, налоговый вычет, медицинские услуги, Клиника Одинцова, СПб, Санкт-Петербург"
  ogImage="/images/og/tax-form.webp"
>
  <script type="application/ld+json" set:html={JSON.stringify(taxFormSchema)} />
  <BreadcrumbNav items={[{ label: 'Форма для налоговой' }]} />

  <section class="pt-4 pb-16">
    <div class="container-clay">
      <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1.1fr)_minmax(280px,0.9fr)] gap-6 items-end mb-8">
        <div>
          <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border-color)] bg-[color:var(--surface-card)] px-4 py-2 text-sm font-semibold text-clay-dark shadow-[var(--shadow-xs)] mb-5">
            <FileText size={14} aria-hidden="true" />
            Для пациентов клиники
          </div>
          <h1 class="text-4xl sm:text-5xl heading-display text-clay-dark leading-tight mb-4">
            Запрос справки для налогового вычета
          </h1>
          <p class="text-clay-muted text-lg leading-relaxed max-w-3xl">
            Заполните данные пациента, налогоплательщика и контакты. Сотрудник клиники проверит заявку и свяжется с вами, если потребуется уточнение.
          </p>
        </div>
        <div class="clay-card-soft-mint clay-card p-5 md:p-6">
          <div class="flex items-start gap-3">
            <div class="icon-circle-mint h-11 w-11 rounded-[16px]">
              <ShieldCheck size={19} className="text-white" aria-hidden="true" />
            </div>
            <div>
              <h2 class="text-lg font-bold text-clay-dark mb-2">Что важно перед отправкой</h2>
              <p class="text-sm text-clay-muted leading-relaxed">
                В форме нужны только сведения для подготовки справки: ФИО, даты рождения, ИНН налогоплательщика, год справки и контакты.
              </p>
            </div>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 xl:grid-cols-[minmax(0,0.95fr)_minmax(360px,1.05fr)] gap-8 items-start">
        <div class="space-y-6">
          <div class="clay-card p-6 md:p-7">
            <h2 class="text-2xl heading-serif text-clay-dark mb-5">Как проходит заявка</h2>
            <div class="space-y-5">
              {[
                {
                  title: 'Данные в одной форме',
                  text: 'Можно указать пациента и налогоплательщика отдельно, если справка оформляется не на самого пациента.',
                },
                {
                  title: 'Проверка сотрудником клиники',
                  text: 'Мы сверим заявку и свяжемся по email или телефону, если для справки не хватает данных.',
                },
                {
                  title: 'Подготовка справки',
                  text: 'После проверки сотрудники клиники подготовят справку для налоговой инспекции.',
                },
              ].map((item) => (
                <div class="flex items-start gap-3">
                  <CheckCircle2 size={18} className="text-clay-mint mt-0.5 shrink-0" aria-hidden="true" />
                  <div>
                    <h3 class="font-bold text-clay-dark text-sm mb-1">{item.title}</h3>
                    <p class="text-sm text-clay-muted leading-relaxed">{item.text}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <div class="clay-card p-6 md:p-7">
            <h2 class="text-2xl heading-serif text-clay-dark mb-5">Что подготовить</h2>
            <div class="grid gap-3 sm:grid-cols-2">
              {[
                'ФИО и дату рождения пациента',
                'ФИО налогоплательщика',
                'Дату рождения и ИНН налогоплательщика',
                'Email, телефон и год справки',
              ].map((item) => (
                <div class="rounded-[16px] border border-[color:var(--border-color)] bg-[color:var(--surface-muted)] px-4 py-3 text-sm font-medium text-clay-dark">
                  {item}
                </div>
              ))}
            </div>
          </div>

          <FaqSection items={FAQ_ITEMS} title="Частые вопросы" />
        </div>

        <div class="xl:sticky xl:top-24 space-y-5">
          <TaxFormRequestForm client:idle />

          <div class="clay clay-card-soft-blue p-5">
            <h2 class="text-lg font-extrabold text-clay-dark mb-2">Нужна помощь с заполнением?</h2>
            <p class="text-sm text-clay-muted leading-relaxed mb-4">
              Если не уверены, какие данные указать в заявке, позвоните в клинику. Подскажем, как оформить запрос без лишних шагов.
            </p>
            <a href={`tel:${PHONE_NUMBER}`} class="clay btn-clay-secondary w-full justify-center gap-2">
              <Phone size={16} aria-hidden="true" />
              Позвонить: {PHONE_DISPLAY}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
