---
export const prerender = false
import Layout from '../layouts/Layout.astro'
import { Prices, buildPriceSchemaItems } from '../components/pages/Prices.jsx'
import { BreadcrumbNav } from '../components/BreadcrumbNav.jsx'
import { db, Service } from 'astro:db'

const services = await db.select().from(Service);
const priceSchemaItems = buildPriceSchemaItems(services)

const pricesSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Прайс-лист Клиники Одинцова',
  description: 'Цены и состав услуг: маммология, гинекология, эндокринология и нутрициология в Санкт-Петербурге',
  url: 'https://odintsovclinic.ru/prices',
  numberOfItems: priceSchemaItems.length,
  itemListElement: priceSchemaItems,
}
---

<Layout
  title="Цены и состав услуг - Клиника Одинцова в Санкт-Петербурге"
  description="Прайс-лист клиники в Санкт-Петербурге: маммология, гинекология, эндокринология и нутрициология. Видно, что входит в приём и что оплачивается отдельно."
  keywords="цены клиника Одинцова, прайс СПб, стоимость ВАБ СПб, маммолог цены СПб, гинеколог цены СПб, эндокринолог цены СПб, нутрициолог цены СПб"
>
  <script type="application/ld+json" set:html={JSON.stringify(pricesSchema)} />
  <BreadcrumbNav items={[{ label: 'Цены' }]} />
  <Prices servicesData={services} client:load />
</Layout>
