# Переменные окружения для production-деплоя
# Скопируйте этот файл в .env и заполните реальными значениями:
#   cp .env.example .env

# Пароль для входа в админ-панель (/admin)
ADMIN_PASSWORD=your_secure_password_here

# Секрет для HMAC-подписи токенов (рекомендуется: openssl rand -hex 32)
TOKEN_SECRET=your_long_random_secret_here

# Серверный токен клиники Medflex; никогда не публикуется как PUBLIC_*
MEDFLEX_CLINIC_TOKEN=

# Отдельный случайный секрет HMAC для дедупликации онлайн-записи
BOOKING_INTENT_SECRET=

# Стабильный отдельный HMAC-секрет для поиска пациента по телефону
# Генерация: openssl rand -hex 32
CONTACT_FINGERPRINT_KEY=

# Отдельный AES-256-GCM ключ профилей пациентов, строго base64 от 32 байт
# Генерация: openssl rand -base64 32
PATIENT_ENCRYPTION_KEY=

# Идентификатор API-коннектора ВАТС из личного кабинета MANGO OFFICE
MANGO_VPBX_API_KEY=

# Соль подписи того же API-коннектора; хранится только на сервере
MANGO_VPBX_API_SALT=

# Отдельный AES-256-GCM ключ номеров звонящих, строго base64 от 32 байт
# Генерация: openssl rand -base64 32
MANGO_CALL_ENCRYPTION_KEY=

# Обязательный список входящих линий через запятую в международном формате
MANGO_INBOUND_LINES=+78127482210

# SMTP-конфиг для формы "Второе мнение"
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=mailer@example.com
SMTP_PASS=replace_me
SMTP_SECURE=true

# Необязательный адрес отправителя; если пусто, используется SMTP_USER
FROM_EMAIL=

# Адрес клиники, на который приходят заявки
TO_EMAIL=clinic@example.com
# Получатели заявок на налоговую справку; только адреса @odintsovclinic.ru, через запятую
TAX_FORM_TO_EMAIL=info@odintsovclinic.ru

# Срок хранения аналитики посещений в днях (сессии, просмотры, события); по умолчанию 90
ANALYTICS_RETENTION_DAYS=

# Через сколько дней номер звонящего удаляется из журнала MANGO (метрики остаются); по умолчанию 365
MANGO_CALL_RETENTION_DAYS=

# Необязательный путь к status.json хостового монитора (scripts/monitor.sh);
# по умолчанию /var/lib/clod-monitor/status.json, смонтированный в контейнер только для чтения
MONITOR_STATUS_FILE=

# Путь к SQLite-базе данных внутри Docker volume
# Значение менять не нужно - volume монтируется в /data
ASTRO_DB_REMOTE_URL=file:/data/db.sqlite

# Токен libsql для удалённой базы; для локального файла SQLite оставьте пустым
ASTRO_DB_APP_TOKEN=

# Polza.ai API key for blog image generation (dev only)
IMAGE_API_KEY=

# Домен сайта для генерации nginx.conf (scripts/render-nginx.sh) и путей сертификата
SITE_DOMAIN=new.odintsovclinic.ru

# Запрет индексации поисковиками (staging/preview поддомены).
# Установите NOINDEX=true на сервере поддомена, оставьте пустым на production.
NOINDEX=
