---
import { DoctorsDemo } from '../components/pages/DoctorsDemo.jsx'
import '../styles/global.css'
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Тестовая страница с карточками врачей в стиле claymorphism: заголовок, фильтры направлений и карточки врачей."
    />
    <title>Тест clay-карточек врачей — Клиника Одинцова</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-clay-bg font-sans">
    <main>
      <DoctorsDemo client:load />
    </main>
  </body>
</html>
