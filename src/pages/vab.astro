  "howPerformed": "Под местной анестезией через прокол 2 мм вводится игла устройства Xishan DK-B-MS. Под контролем УЗИ образование полностью удаляется вакуумным механизмом. Материал отправляется на гистологию.",
  "location": {
    "@type": "Place",
    "name": "Клиника Одинцова",
    "address": {
      "@type": "PostalAddress",
      streetAddress: "пр. Богатырский, д. 22, к. 1",
      addressLocality: "Санкт-Петербург",
      postalCode: "197374",
      addressRegion: "Санкт-Петербург",
      addressCountry: "RU",
    },
  },
  "status": "ActiveActionStatus",
  "medicineSystem": "Western",
  "recognizingAuthority": {
    "@type": "Organization",
    "name": "Клиника Одинцова",
    "url": "https://odintsovclinic.ru"
  },
  "usesDevice": {
    "@type": "MedicalDevice",
    "name": "Xishan DK-B-MS",
    "manufacturer": {
      "@type": "Organization",
      "name": "Xishan Sience & Technology Co.",
      "address": {
        "@type": "PostalAddress",
