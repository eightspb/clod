---
import Layout from '../layouts/Layout.astro'
import ServiceArticles from '../components/ServiceArticles.astro'
import { Adenomioz, ADENOMIOZ_FAQ } from '../components/pages/Adenomioz.jsx'
import { BreadcrumbNav } from '../components/BreadcrumbNav.jsx'
import { generateFaqSchema } from '../utils/schema.js'

const conditionSchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalCondition',
  '@id': 'https://odintsovclinic.ru/adenomioz#condition',
  url: 'https://odintsovclinic.ru/adenomioz',
  name: 'Аденомиоз',
  alternateName: 'Adenomyosis',
  description: 'Состояние, при котором ткань эндометрия врастает в мышечный слой матки (миометрий), вызывая болезненные и обильные менструации, хроническую тазовую боль.',
  associatedAnatomy: {
    '@type': 'AnatomicalStructure',
    name: 'Матка',
  },
  signOrSymptom: [
    { '@type': 'MedicalSymptom', name: 'Дисменорея (болезненные менструации)' },
    { '@type': 'MedicalSymptom', name: 'Меноррагия (обильные менструации)' },
    { '@type': 'MedicalSymptom', name: 'Хроническая тазовая боль' },
    { '@type': 'MedicalSymptom', name: 'Анемия' },
  ],
  possibleTreatment: [
    {
      '@type': 'MedicalTherapy',
      name: 'Гормональная терапия (прогестины, ЛНГ-ВМС, агонисты ГнРГ)',
    },
    {
      '@type': 'MedicalTherapy',
      name: 'Эмболизация маточных артерий',
    },
    {
      '@type': 'MedicalTherapy',
      name: 'Гистерэктомия',
    },
  ],
}

const faqSchema = generateFaqSchema(ADENOMIOZ_FAQ)
---

<Layout
  pageType="MedicalWebPage"
  mainEntityId="https://odintsovclinic.ru/adenomioz#condition"
  title="Аденомиоз — консультация гинеколога в СПб"
  description="Гинеколог при аденомиозе в Санкт-Петербурге: обсуждение жалоб, разбор результатов УЗИ и индивидуальный план лечения или наблюдения. Клиника Одинцова."
  keywords="аденомиоз лечение СПб, гинеколог Санкт-Петербург, аденомиоз симптомы, обильные менструации, болезненные месячные лечение, Приморский район СПб"
  ogImage="/images/og/adenomioz.webp"
>
  <script type="application/ld+json" set:html={JSON.stringify(conditionSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <BreadcrumbNav items={[{ label: 'Гинекология', href: '/gynecology' }, { label: 'Аденомиоз' }]} />
  <Adenomioz client:idle />
  <ServiceArticles articles={[
    { slug: 'adenomioz-prichiny-simptomy-lechenie', title: 'Аденомиоз: когда матка «болит изнутри»' },
    { slug: 'tazovye-boli-u-zhenshchin', title: 'Тазовые боли у женщин: 6 причин, которые нельзя игнорировать' },
    { slug: 'kak-prokhodit-priem-ginekologa', title: 'Как проходит приём гинеколога' },
  ]} />
</Layout>
