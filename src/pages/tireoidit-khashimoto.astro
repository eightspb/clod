---
import Layout from '../layouts/Layout.astro'
import ServiceArticles from '../components/ServiceArticles.astro'
import { TireoiditKhashimoto, TIREOIDIT_FAQ } from '../components/pages/TireoiditKhashimoto.jsx'
import { BreadcrumbNav } from '../components/BreadcrumbNav.jsx'
import { generateFaqSchema } from '../utils/schema.js'

const conditionSchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalCondition',
  '@id': 'https://odintsovclinic.ru/tireoidit-khashimoto#condition',
  url: 'https://odintsovclinic.ru/tireoidit-khashimoto',
  name: 'Тиреоидит Хашимото',
  alternateName: 'Hashimoto thyroiditis',
  description: 'Аутоиммунное заболевание щитовидной железы, при котором иммунная система вырабатывает антитела против клеток железы, вызывая хроническое воспаление и постепенное снижение функции (гипотиреоз).',
  associatedAnatomy: {
    '@type': 'AnatomicalStructure',
    name: 'Щитовидная железа',
  },
  signOrSymptom: [
    { '@type': 'MedicalSymptom', name: 'Хроническая усталость' },
    { '@type': 'MedicalSymptom', name: 'Набор веса' },
    { '@type': 'MedicalSymptom', name: 'Зябкость' },
    { '@type': 'MedicalSymptom', name: 'Увеличение щитовидной железы (зоб)' },
    { '@type': 'MedicalSymptom', name: 'Повышенные антитела к ТПО' },
  ],
  possibleTreatment: [
    {
      '@type': 'MedicalTherapy',
      name: 'Заместительная терапия левотироксином',
    },
    {
      '@type': 'MedicalTherapy',
      name: 'Динамическое наблюдение при эутиреозе',
    },
    {
      '@type': 'MedicalTherapy',
      name: 'Коррекция микронутриентов (селен, витамин D)',
    },
  ],
}

const faqSchema = generateFaqSchema(TIREOIDIT_FAQ)
---

<Layout
  pageType="MedicalWebPage"
  mainEntityId="https://odintsovclinic.ru/tireoidit-khashimoto#condition"
  title="Тиреоидит Хашимото — эндокринолог в СПб"
  description="Консультация эндокринолога при аутоиммунном тиреоидите Хашимото в Санкт-Петербурге. Анализы, УЗИ по показаниям и план наблюдения. Клиника Одинцова."
  keywords="тиреоидит Хашимото лечение СПб, аутоиммунный тиреоидит, эндокринолог Санкт-Петербург, антитела к ТПО, щитовидная железа, гипотиреоз лечение, Приморский район СПб"
  ogImage="/images/og/tireoidit-khashimoto.webp"
>
  <script type="application/ld+json" set:html={JSON.stringify(conditionSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <BreadcrumbNav items={[{ label: 'Эндокринология', href: '/endocrinology' }, { label: 'Тиреоидит Хашимото' }]} />
  <TireoiditKhashimoto client:idle />
  <ServiceArticles articles={[
    { slug: 'zabolevaniya-schitovidnoy-zhelezy', title: 'Заболевания щитовидной железы у женщин: гипотиреоз и тиреоидит Хашимото' },
    { slug: 'gipotireoz-simptomy-lechenie', title: 'Гипотиреоз: симптомы, диагностика и лечение' },
    { slug: 'kak-podgotovitsya-k-priemu-endokrinologa', title: 'Как подготовиться к приёму эндокринолога' },
  ]} />
</Layout>
