---
import { Header } from '../components/Header.jsx'
import { Footer } from '../components/Footer.jsx'
import { StickyCTA } from '../components/StickyCTA.jsx'
import { BookingFlow } from '../components/booking/BookingFlow.jsx'
import { DOCTORS } from '../lib/doctors-data.js'
import { doctorGroups } from '../lib/nav.js'
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
  keywords?: string
  ogImage?: string
  ogImageAlt?: string
  ogType?: string
  canonicalUrl?: string
  pageDoctorSlug?: string
}

const {
  title = 'Клиника Одинцова - Экспертная медицина',
  description = 'Экспертная медицина в маммологии, гинекологии, эндокринологии и нутрициологии. ВАБ, консультации профильных специалистов и бережный подход к пациенту.',
  keywords = 'клиника Одинцова, маммолог Санкт-Петербург, ВАБ СПб, гинеколог СПб, эндокринолог СПб, нутрициолог СПб',
  ogImage = '/images/og/index.webp',
  ogImageAlt = '',
  ogType = 'website',
  canonicalUrl = `https://odintsovclinic.ru${Astro.url.pathname}`,
  pageDoctorSlug = '',
} = Astro.props

const currentPath = Astro.url.pathname
const absoluteUrl = (path) => new URL(path, Astro.site).href
const NAV_DOCTOR_GROUPS = doctorGroups(DOCTORS)
const BOOKING_DOCTORS = DOCTORS.map(({ slug, name, specialization, photo, photoThumb }) => ({ slug, name, specialization, photo: photoThumb || photo }))
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <title>{title}</title>

    <!-- GEO -->
    <meta name="geo.region" content="RU-SPE" />
    <meta name="geo.placename" content="Санкт-Петербург" />
    <meta name="geo.position" content="60.001014;30.251746" />
    <meta name="ICBM" content="60.001014, 30.251746" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage.startsWith('http') ? ogImage : absoluteUrl(ogImage)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt || title} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Клиника Одинцова" />
    <meta property="og:locale" content="ru_RU" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.startsWith('http') ? ogImage : absoluteUrl(ogImage)} />

    <!-- hreflang -->
    <link rel="alternate" hreflang="ru" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

    <!-- Шрифт Golos Text - самохостинг (без внешнего CDN) -->
    <link rel="preload" href="/fonts/golos-text-var-cyrillic.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/golos-text-var-latin.woff2" as="font" type="font/woff2" crossorigin="anonymous" />

  <slot name="head" />


    <!-- JSON-LD: MedicalBusiness -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "MedicalBusiness",
      "name": "Клиника Одинцова",
      "alternateName": "Клиника доктора Одинцова",
      "url": "https://odintsovclinic.ru",
      "logo": absoluteUrl('/images/logo.png'),
      "image": absoluteUrl('/images/og/index.webp'),
      "telephone": "+78127482210",
      "email": "info@odintsovclinic.ru",
      "priceRange": "$$",
      "currenciesAccepted": "RUB",
      "paymentAccepted": "Наличные, банковская карта, ДМС",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "пр. Богатырский, д. 22, к. 1",
        "addressLocality": "Санкт-Петербург",
        "postalCode": "197374",
        "addressRegion": "Санкт-Петербург",
        "addressCountry": "RU"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 60.001014,
        "longitude": 30.251746
      },
      "hasMap": "https://yandex.ru/maps/?pt=30.251746,60.001014&z=16&l=map",
      "openingHours": ["Mo-Fr 09:00-20:00", "Sa-Su 10:00-18:00"],
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
          "opens": "09:00",
          "closes": "20:00"
        },
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Saturday","Sunday"],
          "opens": "10:00",
          "closes": "18:00"
        }
      ],
      "medicalSpecialty": ["Oncology", "Gynecology", "Endocrinology", "Nutrition"],
      "areaServed": [
        {"@type": "City", "name": "Санкт-Петербург"},
        {"@type": "AdministrativeArea", "name": "Ленинградская область"},
        {"@type": "AdministrativeArea", "name": "Приморский район"},
        {"@type": "AdministrativeArea", "name": "Выборгский район"},
        {"@type": "AdministrativeArea", "name": "Петроградский район"}
      ],
      "sameAs": [
        "https://t.me/odintsovclinic",
        "https://vk.com/odintsovclinic",
        "https://prodoctorov.ru/spb/lpu/130932-klinika-odincova/",
        "https://2gis.ru/spb/firm/70000001062793440",
        "https://yandex.ru/maps/org/klinika_odincova/1127907054/"
      ],
      "speakable": {
        "@type": "SpeakableSpecification",
        "cssSelector": ["h1", ".speakable"]
      }
    })} />
  </head>
  <body class="relative min-h-screen bg-clay-bg">
    <a href="#main-content" class="sr-only focus-visible:not-sr-only focus-visible:fixed focus-visible:top-4 focus-visible:left-4 focus-visible:z-[9999] focus-visible:px-4 focus-visible:py-2 focus-visible:bg-clay-mint-dark focus-visible:text-white focus-visible:rounded-xl focus-visible:font-semibold focus-visible:shadow-lg">
      Перейти к содержимому
    </a>
    <Header currentPath={currentPath} doctorGroups={NAV_DOCTOR_GROUPS} client:load />
    <main id="main-content" class="relative" style="z-index:1" data-pagefind-body>
      <slot />
    </main>
    <div data-pagefind-ignore>
      <Footer />
    </div>
    <StickyCTA client:idle />
    <!-- BookingFlow hydrates on idle; clicks on booking triggers made before that are parked on the trigger and replayed once the island mounts -->
    <script is:inline>
      (function () {
        function rememberBookingClick(event) {
          var trigger = event.target && event.target.closest ? event.target.closest('[data-booking-btn]') : null
          if (!trigger) return
          event.preventDefault()
          trigger.setAttribute('data-booking-pending', '')
        }
        document.addEventListener('click', rememberBookingClick, true)
        document.addEventListener('clod:booking-ready', function () {
          document.removeEventListener('click', rememberBookingClick, true)
        }, { once: true })
      })()
    </script>
    <BookingFlow doctors={BOOKING_DOCTORS} pageDoctorSlug={pageDoctorSlug} client:idle />

    <div id="font-size-controls" class="hidden md:fixed md:bottom-6 md:right-6 md:z-50 md:flex md:flex-col md:gap-2">
      <button
        id="font-increase"
        aria-label="Увеличить шрифт"
        class="w-11 h-11 rounded-2xl bg-white shadow-lg border border-clay-border flex items-center justify-center text-lg font-bold text-clay-text hover:bg-clay-mint-dark hover:text-white transition-all duration-200 select-none"
      >A+</button>
      <button
        id="font-reset"
        aria-label="Сбросить размер шрифта"
        class="w-11 h-11 rounded-2xl bg-white shadow-lg border border-clay-border flex items-center justify-center text-xs font-semibold text-clay-muted hover:bg-clay-bg transition-all duration-200 select-none"
      >A</button>
      <button
        id="font-decrease"
        aria-label="Уменьшить шрифт"
        class="w-11 h-11 rounded-2xl bg-white shadow-lg border border-clay-border flex items-center justify-center text-sm font-bold text-clay-text hover:bg-clay-mint-dark hover:text-white transition-all duration-200 select-none"
      >A−</button>
    </div>

    <script>
      import {
        FONT_SIZE_DEFAULT,
        FONT_SIZE_STORAGE_KEY,
        decreaseFontSize,
        increaseFontSize,
        readFontSize,
      } from '../lib/font-size.js'

      function applySize(size) {
        document.documentElement.style.fontSize = `${size}%`
        localStorage.setItem(FONT_SIZE_STORAGE_KEY, String(size))
      }

      function getSize() {
        return readFontSize(localStorage.getItem(FONT_SIZE_STORAGE_KEY))
      }

      applySize(getSize())

      document.getElementById('font-increase').addEventListener('click', () => {
        applySize(increaseFontSize(getSize()))
      })

      document.getElementById('font-decrease').addEventListener('click', () => {
        applySize(decreaseFontSize(getSize()))
      })

      document.getElementById('font-reset').addEventListener('click', () => {
        applySize(FONT_SIZE_DEFAULT)
      })
    </script>

    <!-- Трекер аналитики: defer чтобы не блокировать отрисовку (Lighthouse) -->
    <script src="/tracker.js" defer></script>

  </body>
</html>
