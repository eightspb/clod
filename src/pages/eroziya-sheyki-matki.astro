---
import Layout from '../layouts/Layout.astro'
import ServiceArticles from '../components/ServiceArticles.astro'
import { EroziyaSheykyMatki, EROZIYA_FAQ } from '../components/pages/EroziyaSheykyMatki.jsx'
import { BreadcrumbNav } from '../components/BreadcrumbNav.jsx'
import { generateFaqSchema } from '../utils/schema.js'

const conditionSchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalCondition',
  '@id': 'https://odintsovclinic.ru/eroziya-sheyki-matki#condition',
  url: 'https://odintsovclinic.ru/eroziya-sheyki-matki',
  name: 'Эрозия шейки матки',
  alternateName: 'Эктопия шейки матки',
  description: 'Изменение эпителия шейки матки. Чаще речь идёт об эктопии: смещении цилиндрического эпителия цервикального канала на наружную поверхность шейки. При простой эктопии без атипии это вариант нормы у молодых женщин.',
  associatedAnatomy: {
    '@type': 'AnatomicalStructure',
    name: 'Шейка матки',
  },
  possibleTreatment: [
    {
      '@type': 'MedicalTherapy',
      name: 'Динамическое наблюдение',
    },
    {
      '@type': 'MedicalTherapy',
      name: 'Радиоволновое воздействие',
    },
    {
      '@type': 'MedicalTherapy',
      name: 'Лазерная коагуляция',
    },
  ],
}

const faqSchema = generateFaqSchema(EROZIYA_FAQ)
---

<Layout
  pageType="MedicalWebPage"
  mainEntityId="https://odintsovclinic.ru/eroziya-sheyki-matki#condition"
  title="Эрозия шейки матки — гинеколог в СПб | Клиника Одинцова"
  description="Консультация гинеколога при изменениях шейки матки в Санкт-Петербурге. Осмотр, кольпоскопия, наблюдение или лечение по показаниям. Цены и запись."
  keywords="эрозия шейки матки лечение СПб, гинеколог Санкт-Петербург, кольпоскопия, ПАП-тест, прижигание эрозии, радиоволновое лечение, Приморский район СПб"
  ogImage="/images/og/eroziya-sheyki-matki.webp"
>
  <script type="application/ld+json" set:html={JSON.stringify(conditionSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <BreadcrumbNav items={[{ label: 'Гинекология', href: '/gynecology' }, { label: 'Эрозия шейки матки' }]} />
  <EroziyaSheykyMatki client:idle />
  <ServiceArticles articles={[
    { slug: 'eroziya-sheyki-matki', title: 'Эрозия шейки матки: мифы и правда' },
    { slug: 'abnormalnyy-mazok-chto-delat', title: 'Аномальный результат мазка: что делать дальше' },
    { slug: 'kak-podgotovitsya-k-priemu-ginekologa', title: 'Как подготовиться к приёму гинеколога' },
  ]} />
</Layout>
