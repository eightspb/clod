---
import Layout from '../layouts/Layout.astro'
import { Endocrinology } from '../components/pages/Endocrinology.jsx'
import { BreadcrumbNav } from '../components/BreadcrumbNav.jsx'

const specialtySchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalClinic',
  name: 'Клиника Одинцова - Эндокринология',
  medicalSpecialty: 'Endocrinology',
  availableService: {
    '@type': 'MedicalProcedure',
    name: 'Диагностика и лечение эндокринных заболеваний',
  },
  isPartOf: { '@type': 'MedicalBusiness', name: 'Клиника Одинцова' },
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'пр. Богатырский, д. 22, к. 1',
    addressLocality: 'Санкт-Петербург',
    postalCode: '197374',
    addressRegion: 'Санкт-Петербург',
    addressCountry: 'RU',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 60.001014,
    longitude: 30.251746,
  },
}
---

<Layout
  title="Эндокринология в Санкт-Петербурге - гормоны, щитовидная железа, вес | Клиника Одинцова"
  description="Эндокринология на основе данных: усталость, вес, гормоны. Комплексный анализ ферритина, витаминов и гормонального профиля. Результат через 14 дней."
  keywords="эндокринолог Санкт-Петербург, эндокринолог СПб, щитовидная железа лечение СПб, гипотиреоз лечение СПб, гормоны анализы СПб, эндокринолог Комендантский проспект"
>
  <script type="application/ld+json" set:html={JSON.stringify(specialtySchema)} />
  <BreadcrumbNav items={[{ label: 'Эндокринология' }]} />
  <Endocrinology />
</Layout>
