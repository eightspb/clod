  keywords="контакты клиника Одинцова, адрес маммолог СПб, Богатырский проспект 22, маммолог Комендантский проспект, маммолог Старая Деревня, как добраться клиника Одинцова"
  canonicalUrl="https://odintsovclinic.ru/contacts"
>
  <script type="application/ld+json" set:html={JSON.stringify(contactsSchema)} />
  <BreadcrumbNav items={[{ label: 'Контакты' }]} />
  <Contacts />
</Layout>
