---
import Header from '../components/Header.jsx'
import Footer from '../components/Footer.jsx'
import { StickyCTA } from '../components/StickyCTA.jsx'
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
  keywords?: string
  ogImage?: string
  ogImageAlt?: string
  ogType?: string
  canonicalUrl?: string
}

const {
  title = 'Клиника Одинцова - Экспертная медицина',
  description = 'Клиника экспертной медицины в маммологии, гинекологии, эндокринологии и неврологии. Технология ВАБ - удаление образований за 30 минут без скальпеля и швов.',
  keywords = 'клиника Одинцова, маммолог Санкт-Петербург, ВАБ СПб, гинеколог СПб, эндокринолог СПб, невролог СПб',
  ogImage = '/images/og-default.jpg',
  ogImageAlt = '',
  ogType = 'website',
  canonicalUrl = `https://odintsovclinic.ru${Astro.url.pathname}`,
} = Astro.props

const currentPath = Astro.url.pathname
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    <!-- GEO -->
    <meta name="geo.region" content="RU-SPE" />
    <meta name="geo.placename" content="Санкт-Петербург" />
    <meta name="geo.position" content="60.0028;30.2153" />
    <meta name="ICBM" content="60.0028, 30.2153" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`https://odintsovclinic.ru${ogImage}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt || title} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Клиника Одинцова" />
    <meta property="og:locale" content="ru_RU" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`https://odintsovclinic.ru${ogImage}`} />

    <!-- hreflang -->
    <link rel="alternate" hreflang="ru" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

    <!-- Шрифт Inter - самохостинг (без внешнего CDN) -->
    <link rel="preload" href="/fonts/inter-var-cyrillic.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/inter-var-latin.woff2" as="font" type="font/woff2" crossorigin="anonymous" />

    <slot name="head" />

    <!-- JSON-LD: MedicalBusiness -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "MedicalBusiness",
      "name": "Клиника Одинцова",
      "alternateName": "Клиника доктора Одинцова",
      "url": "https://odintsovclinic.ru",
      "logo": "https://odintsovclinic.ru/images/og-default.jpg",
      "image": "https://odintsovclinic.ru/images/og-default.jpg",
      "telephone": "+78127482210",
      "email": "info@odintsovclinic.ru",
      "priceRange": "$$",
      "currenciesAccepted": "RUB",
      "paymentAccepted": "Наличные, банковская карта, ДМС",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "пр. Богатырский, д. 22, к. 1",
        "addressLocality": "Санкт-Петербург",
        "postalCode": "197374",
        "addressRegion": "Санкт-Петербург",
        "addressCountry": "RU"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 60.0028,
        "longitude": 30.2153
      },
      "hasMap": "https://yandex.ru/maps/-/CHdGkBYD",
      "openingHours": ["Mo-Fr 09:00-20:00", "Sa-Su 10:00-18:00"],
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
          "opens": "09:00",
          "closes": "20:00"
        },
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Saturday","Sunday"],
          "opens": "10:00",
          "closes": "18:00"
        }
      ],
      "medicalSpecialty": ["Oncology", "Gynecology", "Endocrinology", "Neurology"],
      "areaServed": [
        {"@type": "City", "name": "Санкт-Петербург"},
        {"@type": "AdministrativeArea", "name": "Ленинградская область"},
        {"@type": "AdministrativeArea", "name": "Приморский район"}
      ],
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.9",
        "reviewCount": "200",
        "bestRating": "5",
        "worstRating": "1"
      },
      "sameAs": [
        "https://wa.me/79119258022",
        "https://t.me/odintsovclinic",
        "https://prodoctorov.ru/spb/lpu/130932-klinika-odincova/",
        "https://2gis.ru/spb/firm/70000001062793440",
        "https://yandex.ru/maps/org/klinika_odincova/1127907054/"
      ],
      "speakable": {
        "@type": "SpeakableSpecification",
        "cssSelector": ["h1", ".speakable"]
      }
    })} />
  </head>
  <body class="relative min-h-screen bg-clay-bg font-sans">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[9999] focus:px-4 focus:py-2 focus:bg-clay-teal focus:text-white focus:rounded-xl focus:font-semibold focus:shadow-lg">
      Перейти к содержимому
    </a>
    <!-- Крупные блобы: FIXED за контентом (z-index:-1) -->
    <div aria-hidden="true" class="fixed inset-0 pointer-events-none overflow-hidden" style="z-index:-1">
      <div class="blob-mint absolute w-80 h-80 opacity-40" style="top:-60px;right:-60px" />
      <div class="blob-peach absolute w-64 h-64 opacity-32" style="bottom:-40px;left:-60px" />
      <div class="blob-blue absolute w-52 h-52 opacity-25" style="bottom:15%;right:-30px" />
      <div class="blob-lavender absolute w-48 h-48 opacity-28" style="top:20%;left:38%" />
    </div>
    <!-- Маленькие orb: fixed-слой, параллакс через JS (translateY) -->
    <div id="orb-layer" aria-hidden="true" class="fixed inset-0 pointer-events-none overflow-hidden" style="z-index:-1">
      <div class="orb absolute w-5 h-5 opacity-50" data-speed="0.3" style="top:8vh;left:22%;background:linear-gradient(145deg,#FAC8B0,#F0A888)" />
      <div class="orb absolute w-7 h-7 opacity-38" data-speed="0.5" style="top:16vh;right:28%;background:linear-gradient(145deg,#A8D8F4,#78BCE8)" />
      <div class="orb absolute w-3 h-3 opacity-55" data-speed="0.2" style="top:26vh;left:62%;background:linear-gradient(145deg,#CCC0EC,#B4A4DC)" />
      <div class="orb absolute w-6 h-6 opacity-42" data-speed="0.6" style="top:38vh;left:8%;background:linear-gradient(145deg,#A8E4D4,#78D4BC)" />
      <div class="orb absolute w-4 h-4 opacity-48" data-speed="0.4" style="top:50vh;right:18%;background:linear-gradient(145deg,#FAC8B0,#F0A888)" />
      <div class="orb absolute w-8 h-8 opacity-32" data-speed="0.25" style="top:62vh;left:48%;background:linear-gradient(145deg,#A8D8F4,#78BCE8)" />
      <div class="orb absolute w-3 h-3 opacity-50" data-speed="0.55" style="top:74vh;right:40%;background:linear-gradient(145deg,#CCC0EC,#B4A4DC)" />
      <div class="orb absolute w-5 h-5 opacity-40" data-speed="0.35" style="top:88vh;left:72%;background:linear-gradient(145deg,#A8E4D4,#78D4BC)" />
      <div class="orb absolute w-4 h-4 opacity-45" data-speed="0.45" style="top:105vh;right:55%;background:linear-gradient(145deg,#FAC8B0,#F0A888)" />
      <div class="orb absolute w-6 h-6 opacity-36" data-speed="0.3" style="top:120vh;left:15%;background:linear-gradient(145deg,#A8D8F4,#78BCE8)" />
      <div class="orb absolute w-3 h-3 opacity-50" data-speed="0.5" style="top:138vh;right:22%;background:linear-gradient(145deg,#CCC0EC,#B4A4DC)" />
      <div class="orb absolute w-5 h-5 opacity-40" data-speed="0.2" style="top:155vh;left:52%;background:linear-gradient(145deg,#A8E4D4,#78D4BC)" />
      <div class="orb absolute w-7 h-7 opacity-34" data-speed="0.6" style="top:172vh;right:35%;background:linear-gradient(145deg,#FAC8B0,#F0A888)" />
      <div class="orb absolute w-4 h-4 opacity-46" data-speed="0.4" style="top:190vh;left:28%;background:linear-gradient(145deg,#A8D8F4,#78BCE8)" />
      <div class="orb absolute w-3 h-3 opacity-52" data-speed="0.28" style="top:210vh;right:12%;background:linear-gradient(145deg,#CCC0EC,#B4A4DC)" />
      <div class="orb absolute w-6 h-6 opacity-38" data-speed="0.48" style="top:228vh;left:68%;background:linear-gradient(145deg,#A8E4D4,#78D4BC)" />
      <div class="orb absolute w-5 h-5 opacity-44" data-speed="0.35" style="top:248vh;right:42%;background:linear-gradient(145deg,#FAC8B0,#F0A888)" />
      <div class="orb absolute w-4 h-4 opacity-40" data-speed="0.55" style="top:268vh;left:10%;background:linear-gradient(145deg,#A8D8F4,#78BCE8)" />
    </div>
    <Header currentPath={currentPath} client:load />
    <main id="main-content" class="relative" style="z-index:1">
      <slot />
    </main>
    <Footer />
    <StickyCTA client:load />

    <div id="font-size-controls" class="fixed bottom-6 right-6 z-50 flex flex-col gap-2">
      <button
        id="font-increase"
        aria-label="Увеличить шрифт"
        class="w-10 h-10 rounded-2xl bg-white shadow-lg border border-clay-border flex items-center justify-center text-lg font-bold text-clay-text hover:bg-clay-pink hover:text-white transition-all duration-200 select-none"
      >A+</button>
      <button
        id="font-reset"
        aria-label="Сбросить размер шрифта"
        class="w-10 h-10 rounded-2xl bg-white shadow-lg border border-clay-border flex items-center justify-center text-xs font-semibold text-clay-muted hover:bg-clay-bg transition-all duration-200 select-none"
      >A</button>
      <button
        id="font-decrease"
        aria-label="Уменьшить шрифт"
        class="w-10 h-10 rounded-2xl bg-white shadow-lg border border-clay-border flex items-center justify-center text-sm font-bold text-clay-text hover:bg-clay-pink hover:text-white transition-all duration-200 select-none"
      >A−</button>
    </div>

    <script>
      const STORAGE_KEY = 'clod-font-size'
      const MIN = 90
      const MAX = 130
      const STEP = 5
      const DEFAULT = 100

      function applySize(size) {
        document.documentElement.style.fontSize = size + '%'
        localStorage.setItem(STORAGE_KEY, size)
      }

      function getSize() {
        const saved = localStorage.getItem(STORAGE_KEY)
        return saved ? parseInt(saved, 10) : DEFAULT
      }

      applySize(getSize())

      document.getElementById('font-increase').addEventListener('click', () => {
        const next = Math.min(getSize() + STEP, MAX)
        applySize(next)
      })

      document.getElementById('font-decrease').addEventListener('click', () => {
        const next = Math.max(getSize() - STEP, MIN)
        applySize(next)
      })

      document.getElementById('font-reset').addEventListener('click', () => {
        applySize(DEFAULT)
      })
    </script>

    <script src="/tracker.js" is:inline></script>

    <script>
      // #region agent log
      window.addEventListener('load', function () {
        var preloadLatin = document.querySelector('link[rel="preload"][href="/fonts/inter-var-latin.woff2"]')
        var preloadCyr = document.querySelector('link[rel="preload"][href="/fonts/inter-var-cyrillic.woff2"]')
        var bodyText = (document.body && (document.body.innerText || document.body.textContent)) || ''
        var hasLatinChars = /[A-Za-z]/.test(bodyText)
        fetch('http://127.0.0.1:7460/ingest/7cf089c7-4d6e-431f-b961-980290614486',{method:'POST',headers:{'Content-Type':'application/json','X-Debug-Session-Id':'42da84'},body:JSON.stringify({sessionId:'42da84',runId:'run1',hypothesisId:'H5',location:'src/layouts/Layout.astro:font-preload-check',message:'Font preload usage context',data:{hasLatinChars:hasLatinChars,hasPreloadLatin:!!preloadLatin,hasPreloadCyr:!!preloadCyr,lang:document.documentElement.lang || null},timestamp:Date.now()})}).catch(function () {})
      })
      // #endregion

      // Параллакс для орбов: слой fixed, орбы смещаются через translateY
      // При скролле вниз орб сдвигается вверх на scrollY * (1 - speed)
      // speed=1 → орб движется вместе со страницей (полный параллакс)
      // speed=0 → орб не движется (как статичный fixed)
      // speed=0.3-0.6 → мягкий параллакс
      (function () {
        var orbs = document.querySelectorAll('#orb-layer .orb[data-speed]')
        if (!orbs.length) return

        var ticking = false
        function updateOrbs() {
          var scrollY = window.scrollY
          orbs.forEach(function (orb) {
            var speed = parseFloat(orb.getAttribute('data-speed')) || 0.5
            orb.style.transform = 'translateY(' + (scrollY * speed) + 'px)'
          })
          ticking = false
        }

        window.addEventListener('scroll', function () {
          if (ticking) return
          ticking = true
          requestAnimationFrame(updateOrbs)
        }, { passive: true })
      })()
    </script>
  </body>
</html>
