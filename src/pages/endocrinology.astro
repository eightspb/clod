---
import Layout from '../layouts/Layout.astro'
import ServiceArticles from '../components/ServiceArticles.astro'
import { Endocrinology, ENDOCRINOLOGY_FAQ } from '../components/pages/Endocrinology.jsx'
import { BreadcrumbNav } from '../components/BreadcrumbNav.jsx'
import { generateFaqSchema } from '../utils/schema.js'

const specialtySchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': 'https://odintsovclinic.ru/endocrinology#service',
  name: 'Приём эндокринолога в Санкт-Петербурге',
  url: 'https://odintsovclinic.ru/endocrinology',
  provider: { '@id': 'https://odintsovclinic.ru/#clinic' },
  areaServed: { '@type': 'City', name: 'Санкт-Петербург' },
}

const faqSchema = generateFaqSchema(ENDOCRINOLOGY_FAQ)
---

<Layout
  pageType="MedicalWebPage"
  title="Эндокринолог в СПб — приём и цены | Клиника Одинцова"
  description="Приём эндокринолога в Приморском районе Санкт-Петербурга: заболевания щитовидной железы, разбор анализов и план наблюдения. Врачи, цены и запись."
  keywords="эндокринология Санкт-Петербург, эндокринолог Приморский район, щитовидная железа, гормоны, Клиника Одинцова"
  ogImage="/images/og/endocrinology.webp"
>
  <script type="application/ld+json" set:html={JSON.stringify(specialtySchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <BreadcrumbNav items={[{ label: 'Эндокринология' }]} />
  <Endocrinology />
  <ServiceArticles articles={[
    { slug: 'kak-podgotovitsya-k-priemu-endokrinologa', title: 'Как подготовиться к приёму эндокринолога' },
    { slug: 'simptomy-gipotireoza-i-gipertireoza', title: 'Симптомы гипотиреоза и гипертиреоза: когда проверить щитовидную железу' },
    { slug: 'zabolevaniya-schitovidnoy-zhelezy', title: 'Заболевания щитовидной железы у женщин: гипотиреоз и тиреоидит Хашимото' },
  ]} />
</Layout>
