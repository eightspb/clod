---
import { Header } from '../components/Header.jsx'
import { Footer } from '../components/Footer.jsx'
import { StickyCTA } from '../components/StickyCTA.jsx'
import { ThemeSwitcher } from '../components/ThemeSwitcher.jsx'
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
  keywords?: string
  ogImage?: string
  ogImageAlt?: string
  ogType?: string
  canonicalUrl?: string
}

const {
  title = 'Клиника Одинцова - Экспертная медицина',
  description = 'Экспертная медицина в маммологии, гинекологии, эндокринологии и нутрициологии. ВАБ, консультации профильных специалистов и бережный подход к пациенту.',
  keywords = 'клиника Одинцова, маммолог Санкт-Петербург, ВАБ СПб, гинеколог СПб, эндокринолог СПб, нутрициолог СПб',
  ogImage = '/images/og-default.jpg',
  ogImageAlt = '',
  ogType = 'website',
  canonicalUrl = `https://odintsovclinic.ru${Astro.url.pathname}`,
} = Astro.props

const currentPath = Astro.url.pathname
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    {import.meta.env.NOINDEX === 'true' && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <title>{title}</title>

    <!-- GEO -->
    <meta name="geo.region" content="RU-SPE" />
    <meta name="geo.placename" content="Санкт-Петербург" />
    <meta name="geo.position" content="60.001014;30.251746" />
    <meta name="ICBM" content="60.001014, 30.251746" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage.startsWith('http') ? ogImage : `https://odintsovclinic.ru${ogImage}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt || title} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Клиника Одинцова" />
    <meta property="og:locale" content="ru_RU" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.startsWith('http') ? ogImage : `https://odintsovclinic.ru${ogImage}`} />

    <!-- hreflang -->
    <link rel="alternate" hreflang="ru" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

    <!-- Preconnect к сторонним источникам (Lighthouse: ускоряет первый запрос) -->
    <link rel="preconnect" href="https://booking.medflex.ru" crossorigin />

    <!-- Шрифт Golos Text - самохостинг (без внешнего CDN) -->
    <link rel="preload" href="/fonts/golos-text-var-cyrillic.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/golos-text-var-latin.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <!-- Lora — display serif для заголовков -->
    <link rel="preload" href="/fonts/lora-v37-cyrillic_latin-regular.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/lora-v37-cyrillic_latin-700.woff2" as="font" type="font/woff2" crossorigin="anonymous" />

  <slot name="head" />

    <!-- Restore theme settings before paint (prevent FOUC) -->
    <script is:inline>
      (function() {
        try {
          var raw = localStorage.getItem('clod-theme-settings')
          if (!raw) return
          var s = JSON.parse(raw)
          var root = document.documentElement.style
          var presets = {'emerald':'#1B6B5A','slate-blue':'#64748B','dusty-rose':'#9D6B7B','warm-clay':'#8B6F52','sage':'#6B8F71','indigo':'#4F46E5','teal':'#0D9488','amber':'#B45309','plum':'#7E22CE','crimson':'#BE123C','ocean':'#0369A1','forest':'#166534','graphite':'#374151','copper':'#B87333','midnight':'#1E3A5F','mauve':'#8B5CF6','moss':'#5C7A3E','terracotta':'#C1440E','steel':'#2E6D9E','burgundy':'#722F37'}
          var headings = {'lora':"'Lora',Georgia,'Times New Roman',serif",'cormorant':"'Cormorant Garamond',Georgia,'Times New Roman',serif",'playfair':"'Playfair Display',Georgia,serif",'merriweather':"'Merriweather',Georgia,serif",'pt-serif':"'PT Serif',Georgia,serif",'eb-garamond':"'EB Garamond',Georgia,serif",'libre-baskerville':"'Libre Baskerville',Georgia,serif",'spectral':"'Spectral',Georgia,serif",'crimson-pro':"'Crimson Pro',Georgia,serif",'dm-serif':"'DM Serif Display',Georgia,serif"}
          var bodies = {'golos':"'Golos Text','Segoe UI',system-ui,sans-serif",'commissioner':"'Commissioner','Segoe UI',system-ui,sans-serif",'onest':"'Onest','Segoe UI',system-ui,sans-serif",'manrope':"'Manrope','Segoe UI',system-ui,sans-serif",'rubik':"'Rubik','Segoe UI',system-ui,sans-serif",'nunito':"'Nunito','Segoe UI',system-ui,sans-serif",'inter':"'Inter','Segoe UI',system-ui,sans-serif",'pt-sans':"'PT Sans','Segoe UI',system-ui,sans-serif",'open-sans':"'Open Sans','Segoe UI',system-ui,sans-serif",'raleway':"'Raleway','Segoe UI',system-ui,sans-serif"}
          var navs = {'lora':"'Lora',Georgia,'Times New Roman',serif",'cormorant':"'Cormorant Garamond',Georgia,'Times New Roman',serif",'playfair':"'Playfair Display',Georgia,serif",'merriweather':"'Merriweather',Georgia,serif",'pt-serif':"'PT Serif',Georgia,serif",'eb-garamond':"'EB Garamond',Georgia,serif",'libre-baskerville':"'Libre Baskerville',Georgia,serif",'spectral':"'Spectral',Georgia,serif",'crimson-pro':"'Crimson Pro',Georgia,serif",'dm-serif':"'DM Serif Display',Georgia,serif"}
          function h2r(h){return[parseInt(h.slice(1,3),16),parseInt(h.slice(3,5),16),parseInt(h.slice(5,7),16)]}
          function hsl2hex(h,ss,l){var q=l<.5?l*(1+ss):l+ss-l*ss,p=2*l-q;function f(t){t=t<0?t+1:t>1?t-1:t;return t<1/6?p+(q-p)*6*t:t<.5?q:t<2/3?p+(q-p)*(2/3-t)*6:p}return'#'+[f(h/360+1/3),f(h/360),f(h/360-1/3)].map(function(v){return Math.round(v*255).toString(16).padStart(2,'0')}).join('')}
          function hex2hsl(hex){var r=h2r(hex),R=r[0]/255,G=r[1]/255,B=r[2]/255,mx=Math.max(R,G,B),mn=Math.min(R,G,B),l=(mx+mn)/2;if(mx===mn)return{h:0,s:0,l:l};var d=mx-mn,ss=l>.5?d/(2-mx-mn):d/(mx+mn),hh=0;if(mx===R)hh=((G-B)/d+(G<B?6:0))/6;else if(mx===G)hh=((B-R)/d+2)/6;else hh=((R-G)/d+4)/6;return{h:hh*360,s:ss,l:l}}
          function rS(hex){var c=h2r(hex);return c[0]+' '+c[1]+' '+c[2]}
          function rA(hex,a){var c=h2r(hex);return'rgba('+c[0]+','+c[1]+','+c[2]+','+a+')'}
          function apply(hex){
            var o=hex2hsl(hex),h=o.h,ss=o.s,l=o.l
            var hover=hsl2hex(h,ss,Math.max(0,l-.08))
            var light=hsl2hex(h,ss*.4,.96)
            var surf=hsl2hex(h,ss*.35,.95)
            var strong=hsl2hex(h,ss*.4,.88)
            var peach=hsl2hex((h+30)%360,ss*.85,Math.min(.55,l+.12))
            var blue=hsl2hex((h+210)%360,ss*.8,Math.min(.55,l+.08))
            var lav=hsl2hex((h+270)%360,ss*.6,Math.min(.55,l+.1))
            var yel=hsl2hex((h+60)%360,ss*.7,Math.min(.5,l+.1))
            var sP=hsl2hex((h+30)%360,ss*.3,.96),sB=hsl2hex((h+210)%360,ss*.3,.96),sL=hsl2hex((h+270)%360,ss*.25,.96),sY=hsl2hex((h+60)%360,ss*.25,.96)
            var mL=hsl2hex(h,ss*.5,.72),pL=hsl2hex((h+30)%360,ss*.45,.75),bL=hsl2hex((h+210)%360,ss*.4,.75)
            root.setProperty('--accent',hex);root.setProperty('--accent-hover',hover);root.setProperty('--accent-light',light);root.setProperty('--accent-text','#FFFFFF')
            root.setProperty('--color-mint',hex);root.setProperty('--color-mint-rgb',rS(hex))
            root.setProperty('--color-peach',peach);root.setProperty('--color-peach-rgb',rS(peach))
            root.setProperty('--color-blue',blue);root.setProperty('--color-blue-rgb',rS(blue))
            root.setProperty('--color-lavender',lav);root.setProperty('--color-yellow',yel)
            root.setProperty('--color-peach-hover',hsl2hex((h+30)%360,ss*.85,Math.max(0,Math.min(.55,l+.12)-.08)))
            root.setProperty('--color-blue-hover',hsl2hex((h+210)%360,ss*.8,Math.max(0,Math.min(.55,l+.08)-.08)))
            root.setProperty('--surface-mint',surf);root.setProperty('--surface-accent',surf);root.setProperty('--surface-accent-strong',strong)
            root.setProperty('--surface-peach',sP);root.setProperty('--surface-blue',sB);root.setProperty('--surface-lavender',sL);root.setProperty('--surface-yellow',sY)
            root.setProperty('--focus-ring',rA(hex,.5));root.setProperty('--focus-ring-glow',rA(hex,.14))
            root.setProperty('--shadow-mint','0 8px 20px '+rA(hex,.18)+',0 3px 8px '+rA(hex,.1))
            root.setProperty('--shadow-peach','0 8px 20px '+rA(peach,.18)+',0 3px 8px '+rA(peach,.1))
            root.setProperty('--shadow-blue','0 8px 20px '+rA(blue,.18)+',0 3px 8px '+rA(blue,.1))
            root.setProperty('--gradient-badge-mint','linear-gradient(135deg,'+mL+' 0%,'+hex+' 100%)')
            root.setProperty('--gradient-badge-peach','linear-gradient(135deg,'+pL+' 0%,'+peach+' 100%)')
            root.setProperty('--gradient-badge-blue','linear-gradient(135deg,'+bL+' 0%,'+blue+' 100%)')
            root.setProperty('--gradient-card-mint','linear-gradient(135deg,'+surf+' 0%,rgba(255,255,255,0) 60%)')
            root.setProperty('--gradient-card-peach','linear-gradient(135deg,'+sP+' 0%,rgba(255,255,255,0) 60%)')
            root.setProperty('--gradient-card-blue','linear-gradient(135deg,'+sB+' 0%,rgba(255,255,255,0) 60%)')
            root.setProperty('--gradient-cta','linear-gradient(135deg,'+surf+' 0%,'+sP+' 100%)')
          }
          var hex = s.colorId==='custom'&&s.customHex ? s.customHex : presets[s.colorId]
          if(hex) apply(hex)
          if(s.headingId&&headings[s.headingId]) root.setProperty('--font-serif',headings[s.headingId])
          if(s.bodyId&&bodies[s.bodyId]) root.setProperty('--font-body',bodies[s.bodyId])
          if(s.navId&&s.navId!=='inherit'&&navs[s.navId]) root.setProperty('--font-nav',navs[s.navId])
        } catch(e) {}
      })()
    </script>

    <!-- JSON-LD: MedicalBusiness -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "MedicalBusiness",
      "name": "Клиника Одинцова",
      "alternateName": "Клиника доктора Одинцова",
      "url": "https://odintsovclinic.ru",
      "logo": "https://odintsovclinic.ru/images/og-default.jpg",
      "image": "https://odintsovclinic.ru/images/og-default.jpg",
      "telephone": "+78127482210",
      "email": "info@odintsovclinic.ru",
      "priceRange": "$$",
      "currenciesAccepted": "RUB",
      "paymentAccepted": "Наличные, банковская карта, ДМС",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "пр. Богатырский, д. 22, к. 1",
        "addressLocality": "Санкт-Петербург",
        "postalCode": "197374",
        "addressRegion": "Санкт-Петербург",
        "addressCountry": "RU"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 60.001014,
        "longitude": 30.251746
      },
      "hasMap": "https://yandex.ru/maps/?pt=30.251746,60.001014&z=16&l=map",
      "openingHours": ["Mo-Fr 09:00-20:00", "Sa-Su 10:00-18:00"],
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
          "opens": "09:00",
          "closes": "20:00"
        },
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Saturday","Sunday"],
          "opens": "10:00",
          "closes": "18:00"
        }
      ],
      "medicalSpecialty": ["Oncology", "Gynecology", "Endocrinology", "Nutrition"],
      "areaServed": [
        {"@type": "City", "name": "Санкт-Петербург"},
        {"@type": "AdministrativeArea", "name": "Ленинградская область"},
        {"@type": "AdministrativeArea", "name": "Приморский район"},
        {"@type": "AdministrativeArea", "name": "Выборгский район"},
        {"@type": "AdministrativeArea", "name": "Петроградский район"}
      ],
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.9",
        "reviewCount": "200",
        "bestRating": "5",
        "worstRating": "1"
      },
      "sameAs": [
        "https://t.me/odintsovclinic",
        "https://vk.com/odintsovclinic",
        "https://prodoctorov.ru/spb/lpu/130932-klinika-odincova/",
        "https://2gis.ru/spb/firm/70000001062793440",
        "https://yandex.ru/maps/org/klinika_odincova/1127907054/"
      ],
      "speakable": {
        "@type": "SpeakableSpecification",
        "cssSelector": ["h1", ".speakable"]
      }
    })} />
  </head>
  <body class="relative min-h-screen bg-clay-bg">
    <a href="#main-content" class="sr-only focus-visible:not-sr-only focus-visible:fixed focus-visible:top-4 focus-visible:left-4 focus-visible:z-[9999] focus-visible:px-4 focus-visible:py-2 focus-visible:bg-clay-mint-dark focus-visible:text-white focus-visible:rounded-xl focus-visible:font-semibold focus-visible:shadow-lg">
      Перейти к содержимому
    </a>
    <!-- Крупные блобы: FIXED за контентом (z-index:-1) -->
    <div aria-hidden="true" class="fixed inset-0 pointer-events-none overflow-hidden" style="z-index:-1">
      <div class="blob-mint absolute w-72 h-72" style="top:-56px;right:-56px;opacity:0.15" />
      <div class="blob-peach absolute w-60 h-60" style="bottom:-36px;left:-56px;opacity:0.12" />
      <div class="blob-blue absolute w-48 h-48" style="bottom:15%;right:-28px;opacity:0.10" />
      <div class="blob-lavender absolute w-44 h-44" style="top:20%;left:38%;opacity:0.10" />
    </div>
    <Header currentPath={currentPath} client:load />
    <main id="main-content" class="relative" style="z-index:1" data-pagefind-body>
      <slot />
    </main>
    <div data-pagefind-ignore>
      <Footer />
    </div>
    <StickyCTA client:idle />
    <ThemeSwitcher client:idle />

    <div id="font-size-controls" class="fixed bottom-24 md:bottom-6 right-4 md:right-6 z-50 flex flex-col gap-2">
      <button
        id="font-increase"
        aria-label="Увеличить шрифт"
        class="w-10 h-10 rounded-2xl bg-white shadow-lg border border-clay-border flex items-center justify-center text-lg font-bold text-clay-text hover:bg-clay-mint-dark hover:text-white transition-all duration-200 select-none"
      >A+</button>
      <button
        id="font-reset"
        aria-label="Сбросить размер шрифта"
        class="w-10 h-10 rounded-2xl bg-white shadow-lg border border-clay-border flex items-center justify-center text-xs font-semibold text-clay-muted hover:bg-clay-bg transition-all duration-200 select-none"
      >A</button>
      <button
        id="font-decrease"
        aria-label="Уменьшить шрифт"
        class="w-10 h-10 rounded-2xl bg-white shadow-lg border border-clay-border flex items-center justify-center text-sm font-bold text-clay-text hover:bg-clay-mint-dark hover:text-white transition-all duration-200 select-none"
      >A−</button>
    </div>

    <script>
      const STORAGE_KEY = 'clod-font-size'
      const MIN = 95
      const MAX = 135
      const STEP = 5
      const DEFAULT = 105

      function applySize(size) {
        document.documentElement.style.fontSize = size + '%'
        localStorage.setItem(STORAGE_KEY, size)
      }

      function getSize() {
        const saved = localStorage.getItem(STORAGE_KEY)
        return saved ? parseInt(saved, 10) : DEFAULT
      }

      applySize(getSize())

      document.getElementById('font-increase').addEventListener('click', () => {
        const next = Math.min(getSize() + STEP, MAX)
        applySize(next)
      })

      document.getElementById('font-decrease').addEventListener('click', () => {
        const next = Math.max(getSize() - STEP, MIN)
        applySize(next)
      })

      document.getElementById('font-reset').addEventListener('click', () => {
        applySize(DEFAULT)
      })
    </script>

    <!-- Трекер аналитики: defer чтобы не блокировать отрисовку (Lighthouse) -->
    <script src="/tracker.js" defer></script>

    <!-- Medflex Widget: загрузка после idle, чтобы не блокировать main thread (Lighthouse — длительная задача) -->
    <div id="medflexRoundWidgetData" data-src="https://booking.medflex.ru/?user=1c7cca1b1f55aed63a6775079eac0f99&isRoundWidget=true"></div>
    <script is:inline>
      (function() {
        function loadMedflex() {
          if (window.__medflexLoaded) return
          window.__medflexLoaded = true
          var s = document.createElement('script')
          s.src = 'https://booking.medflex.ru/components/round/round_widget_button.js'
          s.charset = 'utf-8'
          s.defer = true
          document.body.appendChild(s)
        }
        if ('requestIdleCallback' in window) {
          requestIdleCallback(loadMedflex, { timeout: 4000 })
        } else {
          setTimeout(loadMedflex, 2000)
        }
      })()
    </script>
    <script is:inline>
      document.addEventListener('click', function(e) {
        var btn = e.target.closest('[data-booking-btn]');
        if (btn) {
          e.preventDefault();
          var widgetBtn = document.querySelector('.medflex-round-widget__button');
          if (widgetBtn) {
            widgetBtn.click();
          } else {
            window.open('https://booking.medflex.ru/?user=1c7cca1b1f55aed63a6775079eac0f99', '_blank');
          }
        }
      });
    </script>

  </body>
</html>
