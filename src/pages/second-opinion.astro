---
import Layout from '../layouts/Layout.astro'
import ServiceArticles from '../components/ServiceArticles.astro'
import { SecondOpinion, SECOND_OPINION_FAQ } from '../components/pages/SecondOpinion.jsx'
import { BreadcrumbNav } from '../components/BreadcrumbNav.jsx'
import { generateFaqSchema } from '../utils/schema.js'

const secondOpinionSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': 'https://odintsovclinic.ru/second-opinion#service',
  name: 'Бесплатное второе мнение онколога-маммолога',
  description: 'Бесплатная проверка диагноза и снимков онкологом-маммологом для пациентов из любого региона России. Помогает спокойно перепроверить показания к операции и обсудить возможные варианты лечения.',
  url: 'https://odintsovclinic.ru/second-opinion',
  provider: { '@id': 'https://odintsovclinic.ru/#clinic' },
  areaServed: { '@type': 'Country', name: 'Россия' },
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'RUB',
    url: 'https://odintsovclinic.ru/second-opinion',
  },
}

const faqSchema = generateFaqSchema(SECOND_OPINION_FAQ)
---

<Layout
  pageType="MedicalWebPage"
  mainEntityId="https://odintsovclinic.ru/second-opinion#service"
  title="Второе мнение маммолога в СПб | Клиника Одинцова"
  description="Получите второе мнение по диагнозу и предложенному лечению молочной железы. Какие документы подготовить и как обратиться в клинику Одинцова в Санкт-Петербурге."
  keywords="второе мнение маммолог, проверить диагноз, онколог-маммолог, Санкт-Петербург, Приморский район, бесплатная консультация"
  ogImage="/images/og/second-opinion.webp"
>
  <script type="application/ld+json" set:html={JSON.stringify(secondOpinionSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <BreadcrumbNav items={[{ label: 'Бесплатное второе мнение' }]} />
  <SecondOpinion client:idle />
  <ServiceArticles articles={[
    { slug: 'vab-ili-operatsiya', title: 'ВАБ или операция при фиброаденоме: как выбрать' },
    { slug: 'fibroadenoma-chastye-voprosy', title: 'Фиброаденома: ответы на частые вопросы' },
    { slug: 'tonkoigolnaya-punktsionnaya-biopsiya', title: 'Тонкоигольная пункционная биопсия молочной железы: как проходит процедура' },
  ]} />
</Layout>
