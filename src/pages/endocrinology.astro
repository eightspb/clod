---
import Layout from '../layouts/Layout.astro'
import { Endocrinology, ENDOCRINOLOGY_FAQ } from '../components/pages/Endocrinology.jsx'
import { BreadcrumbNav } from '../components/BreadcrumbNav.jsx'
import { generateFaqSchema } from '../utils/schema.js'

const specialtySchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalClinic',
  name: 'Клиника Одинцова - Эндокринология',
  medicalSpecialty: 'Endocrinology',
  availableService: {
    '@type': 'MedicalProcedure',
    name: 'Диагностика и лечение эндокринных заболеваний',
  },
  isPartOf: { '@type': 'MedicalBusiness', name: 'Клиника Одинцова' },
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'пр. Богатырский, д. 22, к. 1',
    addressLocality: 'Санкт-Петербург',
    postalCode: '197374',
    addressRegion: 'Санкт-Петербург',
    addressCountry: 'RU',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 60.001014,
    longitude: 30.251746,
  },
}

const faqSchema = generateFaqSchema(ENDOCRINOLOGY_FAQ)
---

<Layout
  title="Эндокринология в Санкт-Петербурге - щитовидная железа, гормоны и вес | Клиника Одинцова"
  description="Эндокринологический приём в Приморском районе Санкт-Петербурга: разбор жалоб, анализов и симптомов, обследования по показаниям и понятный план наблюдения. Удобно от м. Комендантский проспект и м. Старая Деревня."
  keywords="эндокринология Санкт-Петербург, эндокринолог Приморский район, щитовидная железа, гормоны, Клиника Одинцова"
>
  <script type="application/ld+json" set:html={JSON.stringify(specialtySchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <BreadcrumbNav items={[{ label: 'Эндокринология' }]} />
  <Endocrinology />
</Layout>
