---
export const prerender = false
import Layout from '../layouts/Layout.astro'
import ServiceArticles from '../components/ServiceArticles.astro'
import { Gynecology, GYNECOLOGY_FAQ } from '../components/pages/Gynecology.jsx'
import { BreadcrumbNav } from '../components/BreadcrumbNav.jsx'
import { generateFaqSchema } from '../utils/schema.js'
import { db, Service } from '../lib/database.js'
import { eq } from '../lib/database.js'

const services = await db.select().from(Service).where(eq(Service.direction, 'Гинекология'));

const specialtySchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': 'https://odintsovclinic.ru/gynecology#service',
  name: 'Приём гинеколога в Санкт-Петербурге',
  url: 'https://odintsovclinic.ru/gynecology',
  provider: { '@id': 'https://odintsovclinic.ru/#clinic' },
  areaServed: { '@type': 'City', name: 'Санкт-Петербург' },
}

const faqSchema = generateFaqSchema(GYNECOLOGY_FAQ)
---

<Layout
  pageType="MedicalWebPage"
  title="Гинеколог в СПб — приём и цены | Клиника Одинцова"
  description="Приём гинеколога в Приморском районе СПб: осмотр, УЗИ малого таза, кольпоскопия по показаниям. Врачи, цены и запись. Богатырский проспект, 22 к. 1."
  keywords="гинекология Санкт-Петербург, гинеколог Приморский район, УЗИ малого таза, бережный приём, Клиника Одинцова"
  ogImage="/images/og/gynecology.webp"
>
  <script type="application/ld+json" set:html={JSON.stringify(specialtySchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <BreadcrumbNav items={[{ label: 'Гинекология' }]} />
  <Gynecology servicesData={services} client:idle />
  <ServiceArticles articles={[
    { slug: 'kak-podgotovitsya-k-priemu-ginekologa', title: 'Как подготовиться к приёму гинеколога' },
    { slug: 'kak-prokhodit-priem-ginekologa', title: 'Как проходит приём гинеколога' },
    { slug: 'abnormalnyy-mazok-chto-delat', title: 'Аномальный результат мазка: что делать дальше' },
  ]} />
</Layout>
