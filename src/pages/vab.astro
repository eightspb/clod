---
import Layout from '../layouts/Layout.astro'
import { Vab } from '../components/pages/Vab.jsx'
import { BreadcrumbNav } from '../components/BreadcrumbNav.jsx'

const medicalProcedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "Вакуумная аспирационная биопсия (ВАБ)",
  "alternateName": "ВАБ, VAB, Vacuum-Assisted Biopsy",
  "description": "Малоинвазивная процедура удаления доброкачественных образований молочной железы (фиброаденом, кист, папиллом) через прокол 2 мм под контролем УЗИ. Без разреза, без общего наркоза, без швов.",
  "procedureType": "Surgical",
  "bodyLocation": "Молочная железа",
  "preparation": "Специальной подготовки не требуется. Рекомендуется не принимать антикоагулянты за 3–5 дней до процедуры.",
  "followup": "Наблюдение 1–2 часа после процедуры. Контрольное УЗИ через 3–6 месяцев.",
  "howPerformed": "Под местной анестезией через прокол 2 мм вводится игла устройства EnCor Enspire. Под контролем УЗИ образование полностью удаляется вакуумным механизмом. Материал отправляется на гистологию.",
  "status": "ActiveActionStatus",
  "medicineSystem": "Western",
  "recognizingAuthority": {
    "@type": "Organization",
    "name": "Клиника Одинцова",
    "url": "https://odintsovclinic.ru"
  },
  "usesDevice": {
    "@type": "MedicalDevice",
    "name": "EnCor Enspire",
    "manufacturer": {
      "@type": "Organization",
      "name": "BD (Becton, Dickinson and Company)",
      "address": {
        "@type": "PostalAddress",
        "addressCountry": "US"
      }
    }
  },
  "relevantSpecialty": "Mammography",
  "cost": {
    "@type": "MonetaryAmount",
    "currency": "RUB",
    "minValue": 35000
  }
}

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Что такое ВАБ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "ВАБ (вакуумная аспирационная биопсия) - малоинвазивная процедура удаления доброкачественных образований молочной железы через прокол 2 мм без разреза и общего наркоза. Устройство EnCor Enspire (США) под контролем УЗИ точно удаляет образование, одновременно забирая материал для гистологии."
      }
    },
    {
      "@type": "Question",
      "name": "Больно ли делать ВАБ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Нет. Процедура проводится под местной анестезией. Вы можете ощущать лёгкое давление или вибрацию, но боли нет. Большинство пациенток оценивают дискомфорт на 1–2 из 10."
      }
    },
    {
      "@type": "Question",
      "name": "Сколько стоит ВАБ в Санкт-Петербурге?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Стоимость ВАБ в Клинике Одинцова - от 35 000 ₽ «под ключ». В цену включены: консультация, УЗИ, анестезия, сама процедура и гистологическое исследование. Скрытых доплат нет."
      }
    },
    {
      "@type": "Question",
      "name": "Нужна ли госпитализация для ВАБ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Нет. ВАБ - амбулаторная процедура. После 1–2 часов наблюдения вы уходите домой. Больничный лист не нужен, на следующий день можно вернуться к работе."
      }
    },
    {
      "@type": "Question",
      "name": "Останется ли шрам после ВАБ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Нет. Прокол размером 2 мм полностью заживает за 6–8 недель без видимого следа. Форма и объём груди не меняются."
      }
    },
    {
      "@type": "Question",
      "name": "Можно ли убрать фиброаденому без операции?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Да. ВАБ - это и есть альтернатива операции. Вместо разреза скальпелем - прокол 2 мм, вместо стационара - амбулатория, вместо общего наркоза - местная анестезия. Каждый третий пациент, которому рекомендовали операцию, после консультации в нашей клинике избегает её с помощью ВАБ."
      }
    },
    {
      "@type": "Question",
      "name": "Нужно ли направление от врача для ВАБ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Нет, направление не нужно. Вы можете записаться напрямую. На первичной консультации врач проведёт УЗИ и определит, показана ли вам процедура ВАБ."
      }
    },
    {
      "@type": "Question",
      "name": "Что делать, если мне уже назначили операцию на груди?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Воспользуйтесь нашим бесплатным вторым мнением. Онколог-маммолог бесплатно изучит ваши снимки и заключения и скажет, возможна ли замена операции на ВАБ в вашем случае."
      }
    }
  ]
}
---

<Layout
  title="ВАБ - вакуумная аспирационная биопсия в Санкт-Петербурге | Клиника Одинцова"
  description="Удаление фиброаденом, кист и образований молочной железы через прокол 2 мм. Без скальпеля, без наркоза, без швов. Процедура 30 мин. Цена от 35 000 ₽. EnCor Enspire (США)."
  keywords="ВАБ Санкт-Петербург, вакуумная аспирационная биопсия СПб, удаление фиброаденомы без операции, удаление кисты молочной железы СПб, ВАБ цена СПб, ВАБ EnCor Enspire, маммолог ВАБ Комендантский проспект"
  canonicalUrl="https://odintsovclinic.ru/vab"
>
  <script type="application/ld+json" set:html={JSON.stringify(medicalProcedureSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <BreadcrumbNav items={[{ label: 'ВАБ - вакуумная аспирационная биопсия' }]} />
  <Vab />
</Layout>
