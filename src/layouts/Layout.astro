---
import { Header } from '../components/Header.jsx'
import { Footer } from '../components/Footer.jsx'
import { StickyCTA } from '../components/StickyCTA.jsx'
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
  keywords?: string
  ogImage?: string
  ogImageAlt?: string
  ogType?: string
  canonicalUrl?: string
}

const {
  title = 'Клиника Одинцова - Экспертная медицина',
  description = 'Экспертная медицина в маммологии, гинекологии, эндокринологии и нутрициологии. ВАБ, консультации профильных специалистов и бережный подход к пациенту.',
  keywords = 'клиника Одинцова, маммолог Санкт-Петербург, ВАБ СПб, гинеколог СПб, эндокринолог СПб, нутрициолог СПб',
  ogImage = '/images/og-default.jpg',
  ogImageAlt = '',
  ogType = 'website',
  canonicalUrl = `https://odintsovclinic.ru${Astro.url.pathname}`,
} = Astro.props

const currentPath = Astro.url.pathname
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <title>{title}</title>

    <!-- GEO -->
    <meta name="geo.region" content="RU-SPE" />
    <meta name="geo.placename" content="Санкт-Петербург" />
    <meta name="geo.position" content="60.001014;30.251746" />
    <meta name="ICBM" content="60.001014, 30.251746" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage.startsWith('http') ? ogImage : `https://odintsovclinic.ru${ogImage}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt || title} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Клиника Одинцова" />
    <meta property="og:locale" content="ru_RU" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.startsWith('http') ? ogImage : `https://odintsovclinic.ru${ogImage}`} />

    <!-- hreflang -->
    <link rel="alternate" hreflang="ru" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

    <!-- Preconnect к сторонним источникам (Lighthouse: ускоряет первый запрос) -->
    <link rel="preconnect" href="https://booking.medflex.ru" crossorigin />

    <!-- Шрифт Golos Text - самохостинг (без внешнего CDN) -->
    <link rel="preload" href="/fonts/golos-text-var-cyrillic.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/golos-text-var-latin.woff2" as="font" type="font/woff2" crossorigin="anonymous" />

  <slot name="head" />

    <!-- JSON-LD: MedicalBusiness -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "MedicalBusiness",
      "name": "Клиника Одинцова",
      "alternateName": "Клиника доктора Одинцова",
      "url": "https://odintsovclinic.ru",
      "logo": "https://odintsovclinic.ru/images/og-default.jpg",
      "image": "https://odintsovclinic.ru/images/og-default.jpg",
      "telephone": "+78127482210",
      "email": "info@odintsovclinic.ru",
      "priceRange": "$$",
      "currenciesAccepted": "RUB",
      "paymentAccepted": "Наличные, банковская карта, ДМС",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "пр. Богатырский, д. 22, к. 1",
        "addressLocality": "Санкт-Петербург",
        "postalCode": "197374",
        "addressRegion": "Санкт-Петербург",
        "addressCountry": "RU"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 60.001014,
        "longitude": 30.251746
      },
      "hasMap": "https://yandex.ru/maps/?pt=30.251746,60.001014&z=16&l=map",
      "openingHours": ["Mo-Fr 09:00-20:00", "Sa-Su 10:00-18:00"],
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
          "opens": "09:00",
          "closes": "20:00"
        },
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Saturday","Sunday"],
          "opens": "10:00",
          "closes": "18:00"
        }
      ],
      "medicalSpecialty": ["Oncology", "Gynecology", "Endocrinology", "Nutrition"],
      "areaServed": [
        {"@type": "City", "name": "Санкт-Петербург"},
        {"@type": "AdministrativeArea", "name": "Ленинградская область"},
        {"@type": "AdministrativeArea", "name": "Приморский район"},
        {"@type": "AdministrativeArea", "name": "Выборгский район"},
        {"@type": "AdministrativeArea", "name": "Петроградский район"}
      ],
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.9",
        "reviewCount": "200",
        "bestRating": "5",
        "worstRating": "1"
      },
      "sameAs": [
        "https://t.me/odintsovclinic",
        "https://prodoctorov.ru/spb/lpu/130932-klinika-odincova/",
        "https://2gis.ru/spb/firm/70000001062793440",
        "https://yandex.ru/maps/org/klinika_odincova/1127907054/"
      ],
      "speakable": {
        "@type": "SpeakableSpecification",
        "cssSelector": ["h1", ".speakable"]
      }
    })} />
  </head>
  <body class="relative min-h-screen bg-clay-bg font-sans">
    <a href="#main-content" class="sr-only focus-visible:not-sr-only focus-visible:fixed focus-visible:top-4 focus-visible:left-4 focus-visible:z-[9999] focus-visible:px-4 focus-visible:py-2 focus-visible:bg-clay-mint-dark focus-visible:text-white focus-visible:rounded-xl focus-visible:font-semibold focus-visible:shadow-lg">
      Перейти к содержимому
    </a>
    <!-- Крупные блобы: FIXED за контентом (z-index:-1) -->
    <div aria-hidden="true" class="fixed inset-0 pointer-events-none overflow-hidden" style="z-index:-1">
      <div class="blob-mint absolute w-72 h-72 opacity-24" style="top:-56px;right:-56px" />
      <div class="blob-peach absolute w-60 h-60 opacity-18" style="bottom:-36px;left:-56px" />
      <div class="blob-blue absolute w-48 h-48 opacity-16" style="bottom:15%;right:-28px" />
      <div class="blob-lavender absolute w-44 h-44 opacity-16" style="top:20%;left:38%" />
    </div>
    <Header currentPath={currentPath} client:load />
    <main id="main-content" class="relative" style="z-index:1">
      <slot />
    </main>
    <Footer />
    <StickyCTA client:idle />

    <div id="font-size-controls" class="fixed bottom-6 right-6 z-50 hidden md:flex flex-col gap-2">
      <button
        id="font-increase"
        aria-label="Увеличить шрифт"
        class="w-10 h-10 rounded-2xl bg-white shadow-lg border border-clay-border flex items-center justify-center text-lg font-bold text-clay-text hover:bg-clay-mint-dark hover:text-white transition-all duration-200 select-none"
      >A+</button>
      <button
        id="font-reset"
        aria-label="Сбросить размер шрифта"
        class="w-10 h-10 rounded-2xl bg-white shadow-lg border border-clay-border flex items-center justify-center text-xs font-semibold text-clay-muted hover:bg-clay-bg transition-all duration-200 select-none"
      >A</button>
      <button
        id="font-decrease"
        aria-label="Уменьшить шрифт"
        class="w-10 h-10 rounded-2xl bg-white shadow-lg border border-clay-border flex items-center justify-center text-sm font-bold text-clay-text hover:bg-clay-mint-dark hover:text-white transition-all duration-200 select-none"
      >A−</button>
    </div>

    <script>
      const STORAGE_KEY = 'clod-font-size'
      const MIN = 90
      const MAX = 130
      const STEP = 5
      const DEFAULT = 100

      function applySize(size) {
        document.documentElement.style.fontSize = size + '%'
        localStorage.setItem(STORAGE_KEY, size)
      }

      function getSize() {
        const saved = localStorage.getItem(STORAGE_KEY)
        return saved ? parseInt(saved, 10) : DEFAULT
      }

      applySize(getSize())

      document.getElementById('font-increase').addEventListener('click', () => {
        const next = Math.min(getSize() + STEP, MAX)
        applySize(next)
      })

      document.getElementById('font-decrease').addEventListener('click', () => {
        const next = Math.max(getSize() - STEP, MIN)
        applySize(next)
      })

      document.getElementById('font-reset').addEventListener('click', () => {
        applySize(DEFAULT)
      })
    </script>

    <!-- Трекер аналитики: defer чтобы не блокировать отрисовку (Lighthouse) -->
    <script src="/tracker.js" defer></script>

    <!-- Medflex Widget: загрузка после idle, чтобы не блокировать main thread (Lighthouse — длительная задача) -->
    <div id="medflexRoundWidgetData" data-src="https://booking.medflex.ru/?user=1c7cca1b1f55aed63a6775079eac0f99&isRoundWidget=true"></div>
    <script is:inline>
      (function() {
        function loadMedflex() {
          if (window.__medflexLoaded) return
          window.__medflexLoaded = true
          var s = document.createElement('script')
          s.src = 'https://booking.medflex.ru/components/round/round_widget_button.js'
          s.charset = 'utf-8'
          s.defer = true
          document.body.appendChild(s)
        }
        if ('requestIdleCallback' in window) {
          requestIdleCallback(loadMedflex, { timeout: 4000 })
        } else {
          setTimeout(loadMedflex, 2000)
        }
      })()
    </script>
    <script is:inline>
      document.addEventListener('click', function(e) {
        var btn = e.target.closest('[data-booking-btn]');
        if (btn) {
          e.preventDefault();
          var widgetBtn = document.querySelector('.medflex-round-widget__button');
          if (widgetBtn) {
            widgetBtn.click();
          } else {
            window.open('https://booking.medflex.ru/?user=1c7cca1b1f55aed63a6775079eac0f99', '_blank');
          }
        }
      });
    </script>

  </body>
</html>
