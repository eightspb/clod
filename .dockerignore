# Allow-list: the build context contains only what `bun run build` and the
# runtime image need. Everything else (docs, audits, tool state, secrets,
# local exports) never reaches the Docker daemon.
*
!package.json
!bun.lock
!astro.config.mjs
!tailwind.config.js
!postcss.config.js
!tsconfig.json
!docker-entrypoint.sh
!public
!src
!scripts

# Re-exclude development-only content inside the allowed directories
public/uploads/*
public/images/blog/.jobs.json
src/test
src/**/*.test.js
src/**/*.test.jsx
src/**/*.spec.js
src/**/*.spec.jsx
scripts/hooks
