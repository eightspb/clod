---
import Layout from '../layouts/Layout.astro'
import ServiceArticles from '../components/ServiceArticles.astro'
import { Vab, FAQ_ITEMS } from '../components/pages/Vab.jsx'
import { BreadcrumbNav } from '../components/BreadcrumbNav.jsx'
import { generateFaqSchema } from '../utils/schema.js'

const medicalProcedureSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "@id": "https://odintsovclinic.ru/vab#procedure",
  "url": "https://odintsovclinic.ru/vab",
  "name": "Вакуумная аспирационная биопсия (ВАБ)",
  "alternateName": "ВАБ, VAB, Vacuum-Assisted Biopsy",
  "description": "Малоинвазивная процедура удаления доброкачественных образований молочной железы через прокол 2 мм под контролем УЗИ. Решение о проведении ВАБ принимается после очной консультации.",
  "procedureType": "https://schema.org/PercutaneousProcedure",
  "bodyLocation": "Молочная железа",
  "preparation": "Подготовку определяет врач на консультации. Сообщите обо всех лекарствах, влияющих на свёртываемость крови; не отменяйте их самостоятельно.",
  "followup": "Наблюдение 1-2 часа после процедуры. Контрольное УЗИ через 3-6 месяцев.",
  "howPerformed": "Под местной анестезией через прокол 2 мм вводится игла устройства Xishan DK-B-MS. Под контролем УЗИ образование полностью удаляется вакуумным механизмом. Материал отправляется на гистологию.",
}

const faqSchema = generateFaqSchema(FAQ_ITEMS)
---

<Layout
  pageType="MedicalWebPage"
  mainEntityId="https://odintsovclinic.ru/vab#procedure"
  title="ВАБ молочной железы в СПб — цены | Клиника Одинцова"
  description="Вакуумная аспирационная биопсия молочной железы в Санкт-Петербурге. Показания, подготовка, врачи и состав стоимости ВАБ. Запись на консультацию в клинику Одинцова."
  keywords="ВАБ Санкт-Петербург, вакуумная аспирационная биопсия СПб, удаление фиброаденомы, удаление кисты молочной железы, Приморский район, Богатырский проспект"
  canonicalUrl="https://odintsovclinic.ru/vab"
  ogImage="/images/og/vab.webp"
>
  <script type="application/ld+json" set:html={JSON.stringify(medicalProcedureSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <BreadcrumbNav items={[{ label: 'ВАБ - вакуумная аспирационная биопсия' }]} />
  <Vab client:idle />
  <ServiceArticles articles={[
    { slug: 'kak-podgotovitsya-k-vab', title: 'Как подготовиться к ВАБ' },
    { slug: 'vab-ili-operatsiya', title: 'ВАБ или операция при фиброаденоме: как выбрать' },
    { slug: 'fibroadenoma-chastye-voprosy', title: 'Фиброаденома: ответы на частые вопросы' },
  ]} />
</Layout>
