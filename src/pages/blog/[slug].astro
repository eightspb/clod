---
import { getCollection, render } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import { BreadcrumbNav } from '../../components/BreadcrumbNav.jsx'
import { RelatedArticles, PillarPageLink } from '../../components/RelatedArticles.jsx'
import { DOCTORS } from '../../lib/doctors-data.js'
import { RING_COLOR_MAP } from '../../lib/constants.js'
import { ArrowLeft, ArrowRight, CalendarDays, Clock3, Stethoscope, Tags } from 'lucide-react'

function normalizeImageUrl(image) {
  if (!image) return '/images/og/blog.webp'
  if (image.startsWith('http://') || image.startsWith('https://')) return image
  if (image.startsWith('/')) return image
  const normalizedImage = image.replace(/^\/?/, '')
  return normalizedImage.startsWith('images/')
    ? `/${normalizedImage}`
    : `/images/${normalizedImage}`
}

function toAbsoluteUrl(url) {
  return url.startsWith('http://') || url.startsWith('https://')
    ? url
    : `https://odintsovclinic.ru${url}`
}

export async function getStaticPaths() {
  const posts = await getCollection('blog')
  return posts.map((post) => ({
    params: { slug: post.id },
  }))
}

const allPosts = await getCollection('blog')
const { slug } = Astro.params
const post = allPosts.find((entry) => entry.id === slug)

if (!post) {
  throw new Error(`Missing blog post entry for slug "${slug}".`)
}

const { Content } = await render(post)

function findRelatedPosts(currentPost, allEntries, limit = 3) {
  const candidates = allEntries.filter((p) => p.id !== currentPost.id)
  const currentTags = new Set(currentPost.data.tags || [])
  const scored = candidates.map((p) => {
    const categoryMatch = p.data.category === currentPost.data.category ? 10 : 0
    const tagOverlap = (p.data.tags || []).filter((t) => currentTags.has(t)).length
    return { post: p, score: categoryMatch + tagOverlap }
  })
  scored.sort((a, b) => {
    if (b.score !== a.score) return b.score - a.score
    return b.post.data.publishDate.valueOf() - a.post.data.publishDate.valueOf()
  })
  return scored.slice(0, limit).map((s) => s.post)
}

const relatedPosts = findRelatedPosts(post, allPosts)

const relatedArticlesData = relatedPosts.map((p) => ({
  slug: p.id,
  title: p.data.title,
  description: p.data.description,
  category: p.data.category,
  image: normalizeImageUrl(p.data.image),
  imageAlt: p.data.imageAlt || p.data.title,
  publishDate: p.data.publishDate.toISOString(),
}))

const author = post.data.authorSlug
  ? DOCTORS.find((d) => d.slug === post.data.authorSlug)
  : null

const formattedDate = post.data.publishDate.toLocaleDateString('ru-RU', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
})

const updatedDate = post.data.updatedDate
  ? post.data.updatedDate.toLocaleDateString('ru-RU', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    })
  : null

// SEO: blog pages keep a nationwide informational intent by default.
const seoKeywords = post.data.keywords
  ? post.data.keywords
  : `${post.data.category}, ${post.data.title}, Клиника Одинцова`

const canonicalUrl = `https://odintsovclinic.ru/blog/${post.id}`
const ogImageUrl = normalizeImageUrl(post.data.image)
const hasLocalSignals = /санкт-петербург|спб|приморский район|комендантский|старая деревня/i.test(
  `${post.data.description} ${seoKeywords} ${post.data.tags.join(' ')}`
)

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  headline: post.data.title,
  description: post.data.description,
  url: canonicalUrl,
  datePublished: post.data.publishDate.toISOString(),
  ...(post.data.updatedDate && { dateModified: post.data.updatedDate.toISOString() }),
  keywords: seoKeywords,
  author: author
    ? {
        '@type': 'Physician',
        name: author.name,
        url: `https://odintsovclinic.ru/doctors/${author.slug}`,
        jobTitle: author.specialization,
        worksFor: {
          '@type': 'MedicalBusiness',
          name: 'Клиника Одинцова',
          url: 'https://odintsovclinic.ru',
        },
      }
    : {
        '@type': 'Organization',
        name: 'Клиника Одинцова',
        url: 'https://odintsovclinic.ru',
      },
  publisher: {
    '@type': 'MedicalBusiness',
    name: 'Клиника Одинцова',
    url: 'https://odintsovclinic.ru',
    logo: {
      '@type': 'ImageObject',
      url: 'https://odintsovclinic.ru/images/logo.svg',
    },
  },
  medicalAudience: {
    '@type': 'MedicalAudience',
    audienceType: 'Patient',
  },
  ...(hasLocalSignals && {
    spatialCoverage: {
      '@type': 'Place',
      name: 'Санкт-Петербург',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Санкт-Петербург',
        addressRegion: 'Санкт-Петербург',
        addressCountry: 'RU',
      },
    },
  }),
  ...(post.data.image && {
    image: {
      '@type': 'ImageObject',
      url: toAbsoluteUrl(ogImageUrl),
      description: post.data.imageAlt ?? post.data.title,
    },
  }),
  inLanguage: 'ru',
  isPartOf: {
    '@type': 'Blog',
    name: 'Блог Клиники Одинцова',
    url: 'https://odintsovclinic.ru/blog',
  },
}

const breadcrumbItems = [
  { label: 'Блог', href: '/blog' },
  { label: post.data.title },
]
---

<Layout
  title={`${post.data.title} | Клиника Одинцова`}
  description={post.data.description}
  keywords={seoKeywords}
  canonicalUrl={canonicalUrl}
  ogType="article"
  ogImage={ogImageUrl}
  ogImageAlt={post.data.imageAlt || post.data.title}
>
  <Fragment slot="head">
    <!-- Open Graph article -->
    <meta property="article:published_time" content={post.data.publishDate.toISOString()} />
    <meta property="article:modified_time" content={post.data.updatedDate ? post.data.updatedDate.toISOString() : post.data.publishDate.toISOString()} />
    <meta property="article:author" content={author ? author.name : (post.data.author || 'Клиника Одинцова')} />
    <meta property="article:section" content={post.data.category} />
    <meta property="article:locale" content="ru_RU" />
    {post.data.tags.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}
  </Fragment>

  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <BreadcrumbNav items={breadcrumbItems} />

  <div class="container-clay pb-20">
    <div class="blog-article-layout">

      <article class="blog-article-main">
        <header class="mb-10">
          <div class="clay-card p-5 md:p-8">
            <div class="flex flex-wrap items-center gap-2.5 mb-5">
              <span class="blog-category-badge">
                {post.data.category}
              </span>
              {post.data.tags.map((tag) => (
                <span class="text-xs text-clay-muted bg-[color:var(--surface-muted)] px-2.5 py-1 rounded-full">
                  #{tag}
                </span>
              ))}
            </div>
            <h1 class="heading-serif text-3xl md:text-4xl lg:text-5xl text-clay-dark leading-tight mb-5">
              {post.data.title}
            </h1>
            <p class="blog-lead">
              {post.data.description}
            </p>
            <div class="blog-meta border-t border-[color:var(--border-color)] mt-6">
              {author ? (
                <a href={`/doctors/${author.slug}`} class="flex items-center gap-2.5 hover:text-clay-teal transition-colors no-underline">
                  <img
                    src={author.photo}
                    alt={`${author.specialization ? author.specialization.split(',')[0].toLowerCase() + ' ' : ''}${author.name}, клиника Одинцова, СПб`}
                    width="36"
                    height="36"
                    loading="lazy"
                    class="rounded-full object-cover w-9 h-9 ring-2 ring-white shadow-sm"
                  />
                  <div>
                    <span class="block font-semibold text-clay-text text-sm leading-tight">{author.name}</span>
                    <span class="block text-xs text-clay-muted leading-tight">{author.specialization}</span>
                  </div>
                </a>
              ) : (
                <span class="font-medium text-clay-text text-sm">{post.data.author}</span>
              )}
              <span class="inline-flex items-center gap-1.5 text-sm text-clay-muted">
                <CalendarDays size={14} aria-hidden="true" />
                <time datetime={post.data.publishDate.toISOString()}>{formattedDate}</time>
              </span>
              {updatedDate && (
                <span class="text-sm text-clay-muted">Обновлено: {updatedDate}</span>
              )}
              {post.data.readingTime && (
                <span class="text-sm text-clay-muted flex items-center gap-1.5">
                  <Clock3 size={14} aria-hidden="true" />
                  {post.data.readingTime} мин
                </span>
              )}
            </div>
          </div>
        </header>

        {post.data.image && (
          <figure class="mb-10 overflow-hidden rounded-[22px] border border-[color:var(--border-color)] bg-[color:var(--surface-card)] shadow-[var(--shadow-sm)]">
            <img
              src={ogImageUrl}
              alt={post.data.imageAlt || post.data.title}
              width="1200"
              height="630"
              loading="eager"
              class="h-auto w-full object-cover"
            />
          </figure>
        )}

        <div class="prose-clay">
          <Content />
        </div>

        <footer class="mt-14 pt-10 border-t border-gray-100">
          {post.data.ctaType === 'second-opinion' ? (
            <div class="clay-card clay-card-accent-blue p-8 md:p-10 text-center mt-8">
              <h2 class="text-xl font-bold text-white mb-3">Хотите сверить рекомендацию?</h2>
              <p class="text-white/90 mb-6 max-w-md mx-auto leading-relaxed">
                Если вам уже поставили диагноз или предложили операцию, можно получить бесплатное второе мнение. Разберём снимки и документы очно в Санкт-Петербурге.
              </p>
              <a href="/second-opinion" class="btn-clay-white inline-flex items-center gap-2">
                Получить второе мнение
                <ArrowRight size={15} aria-hidden="true" />
              </a>
            </div>
          ) : (
            <div class="clay-card clay-card-accent p-8 md:p-10 text-center mt-8">
              <h2 class="text-xl font-bold text-white mb-3">Нужен очный разбор ситуации?</h2>
              <p class="text-white/90 mb-6 max-w-md mx-auto leading-relaxed">
                Статья помогает сориентироваться, но тактику лечения и объём обследования лучше обсуждать на очной консультации. Если вы в Санкт-Петербурге, подскажем удобный маршрут визита.
              </p>
              <a href="/#appointment" data-booking-btn="true" class="btn-clay-white inline-flex items-center gap-2">
                Записаться на приём
                <ArrowRight size={15} aria-hidden="true" />
              </a>
            </div>
          )}

          <div class="mt-8 text-center">
            <a href="/blog" class="inline-flex items-center gap-2 text-clay-teal hover:underline text-sm font-medium">
              <ArrowLeft size={15} aria-hidden="true" />
              Все статьи блога
            </a>
          </div>
        </footer>
      </article>

      <aside class="blog-article-sidebar">
        {author && (
          <article class="clay clay-card p-5 flex flex-col group mb-5">
            <p class="text-sm font-semibold text-clay-dark mb-4">Автор статьи</p>
            <a href={`/doctors/${author.slug}`} class="no-underline block mb-4">
              <div class={`${RING_COLOR_MAP[author.ringColor] || 'avatar-ring-mint'} flex-shrink-0 w-fit`}>
                <img
                  src={author.photo}
                  alt={`${author.specialization ? author.specialization.split(',')[0].toLowerCase() + ' ' : ''}${author.name}, клиника Одинцова, СПб`}
                  width="144"
                  height="144"
                  loading="lazy"
                  class="rounded-full object-cover w-44 h-44"
                />
              </div>
              <h4 class="font-bold text-clay-dark text-base leading-snug mt-3 group-hover:text-clay-teal transition-colors">{author.name}</h4>
              <p class="text-xs text-clay-muted leading-tight mt-1">{author.specialization.split(',')[0]}</p>
            </a>

            <a
              href={`/doctors/${author.slug}`}
              class="clay btn-clay-primary text-xs py-2 px-4 gap-1 inline-flex no-underline w-fit"
            >
              Профиль врача
              <Stethoscope size={13} aria-hidden="true" />
            </a>
          </article>
        )}

        <div class="clay-card clay-card-soft-mint p-5 mb-5">
          <p class="text-sm font-semibold text-clay-dark mb-3">Запись на приём</p>
          <p class="text-sm text-clay-muted mb-4 leading-relaxed">Если нужен очный маршрут в Санкт-Петербурге, поможем подобрать специалиста и формат визита.</p>
          <a href="/#appointment" data-booking-btn="true" class="btn-clay-primary block text-center text-sm py-2.5">
            Уточнить очный приём
          </a>
        </div>

        <div class="clay-card p-5 mb-5">
          <p class="text-sm font-semibold text-clay-dark mb-3">Тема материала</p>
          <span class="blog-category-badge inline-flex gap-1.5">
            <Tags size={13} aria-hidden="true" />
            {post.data.category}
          </span>
          <div class="mt-3">
            <PillarPageLink category={post.data.category} />
          </div>
          {post.data.tags.length > 0 && (
            <div class="flex flex-wrap gap-1.5 mt-3">
              {post.data.tags.map((tag) => (
                <span class="text-xs text-clay-muted bg-gray-100 px-2 py-0.5 rounded-full">#{tag}</span>
              ))}
            </div>
          )}
        </div>

        {relatedPosts.length > 0 && (
          <div class="clay-card p-5">
            <p class="text-sm font-semibold text-clay-dark mb-4">Читайте также</p>
            <div class="flex flex-col gap-4">
              {relatedPosts.map((related) => (
                <a href={`/blog/${related.slug}`} class="group no-underline block">
                  <h4 class="text-sm font-bold text-clay-text group-hover:text-clay-teal transition-colors leading-snug mb-1.5 line-clamp-2">
                    {related.data.title}
                  </h4>
                  <time class="text-xs text-clay-muted block">
                    {related.data.publishDate.toLocaleDateString('ru-RU', {
                      day: 'numeric',
                      month: 'long',
                      year: 'numeric'
                    })}
                  </time>
                </a>
              ))}
            </div>
          </div>
        )}
      </aside>

    </div>

    <RelatedArticles articles={relatedArticlesData} />
  </div>
</Layout>
