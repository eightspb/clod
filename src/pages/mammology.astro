---
import Layout from '../layouts/Layout.astro'
import { Mammology, MAMMOLOGY_FAQ } from '../components/pages/Mammology.jsx'
import { BreadcrumbNav } from '../components/BreadcrumbNav.jsx'
import { generateFaqSchema } from '../utils/schema.js'

const specialtySchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalClinic',
  name: 'Клиника Одинцова - маммология',
  medicalSpecialty: 'Oncology',
  availableService: {
    '@type': 'MedicalProcedure',
    name: 'Вакуумная аспирационная биопсия (ВАБ)',
  },
  isPartOf: { '@type': 'MedicalBusiness', name: 'Клиника Одинцова' },
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'пр. Богатырский, д. 22, к. 1',
    addressLocality: 'Санкт-Петербург',
    postalCode: '197374',
    addressRegion: 'Санкт-Петербург',
    addressCountry: 'RU',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 60.001014,
    longitude: 30.251746,
  },
}

const faqSchema = generateFaqSchema(MAMMOLOGY_FAQ)
---

<Layout
  title="Маммология в Санкт-Петербурге - консультация, ВАБ и второе мнение | Клиника Одинцова"
  description="Приём маммолога-онколога в Приморском районе Санкт-Петербурга. Консультация, УЗИ, ВАБ по показаниям и второе мнение на Богатырском проспекте, рядом с метро Комендантский проспект и Старая Деревня."
  keywords="маммолог Санкт-Петербург, маммология СПб, ВАБ Санкт-Петербург, фиброаденома, киста молочной железы, Приморский район, Богатырский проспект"
>
  <script type="application/ld+json" set:html={JSON.stringify(specialtySchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <BreadcrumbNav items={[{ label: 'Маммология' }]} />
  <Mammology />
</Layout>
