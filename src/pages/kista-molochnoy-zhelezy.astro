---
import Layout from '../layouts/Layout.astro'
import ServiceArticles from '../components/ServiceArticles.astro'
import { KistaMolochnoyZhelezy, KISTA_FAQ } from '../components/pages/KistaMolochnoyZhelezy.jsx'
import { BreadcrumbNav } from '../components/BreadcrumbNav.jsx'
import { generateFaqSchema } from '../utils/schema.js'

const conditionSchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalCondition',
  '@id': 'https://odintsovclinic.ru/kista-molochnoy-zhelezy#condition',
  url: 'https://odintsovclinic.ru/kista-molochnoy-zhelezy',
  name: 'Киста молочной железы',
  alternateName: 'Breast cyst',
  description: 'Округлая полость, заполненная жидкостью, внутри молочной железы. Образуется при расширении молочных протоков. Бывает простой и сложной формы.',
  associatedAnatomy: {
    '@type': 'AnatomicalStructure',
    name: 'Молочная железа',
  },
  possibleTreatment: [
    {
      '@type': 'MedicalTherapy',
      name: 'Динамическое наблюдение',
    },
    {
      '@type': 'MedicalTherapy',
      name: 'Аспирация кисты под контролем УЗИ',
    },
    {
      '@type': 'MedicalTherapy',
      name: 'Склерозирование кисты',
    },
    {
      '@type': 'MedicalTherapy',
      name: 'Вакуумная аспирационная биопсия (ВАБ)',
    },
  ],
}

const faqSchema = generateFaqSchema(KISTA_FAQ)
---

<Layout
  pageType="MedicalWebPage"
  mainEntityId="https://odintsovclinic.ru/kista-molochnoy-zhelezy#condition"
  title="Киста молочной железы — лечение в СПб | Клиника Одинцова"
  description="Маммолог при кисте молочной железы в Санкт-Петербурге: УЗИ, наблюдение и лечение по показаниям. Стоимость консультации и запись в клинику Одинцова."
  keywords="киста молочной железы, лечение кисты СПб, маммолог Санкт-Петербург, аспирация кисты, УЗИ молочных желёз, Приморский район"
  ogImage="/images/og/kista-molochnoy-zhelezy.webp"
>
  <script type="application/ld+json" set:html={JSON.stringify(conditionSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <BreadcrumbNav items={[{ label: 'Маммология', href: '/mammology' }, { label: 'Киста молочной железы' }]} />
  <KistaMolochnoyZhelezy client:idle />
  <ServiceArticles articles={[
    { slug: 'kista-molochnoy-zhelezy', title: 'Киста молочной железы: причины, симптомы и лечение' },
    { slug: 'mylnaya-opera-o-kistoznoy-mastopatii', title: 'Кистозная мастопатия: что важно понимать' },
    { slug: 'kak-prokhodit-uzi-molochnyh-zhelez', title: 'Как проходит УЗИ молочных желёз' },
  ]} />
</Layout>
