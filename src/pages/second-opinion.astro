---
import Layout from '../layouts/Layout.astro'
import { SecondOpinion, SECOND_OPINION_FAQ } from '../components/pages/SecondOpinion.jsx'
import { BreadcrumbNav } from '../components/BreadcrumbNav.jsx'
import { generateFaqSchema } from '../utils/schema.js'

const secondOpinionSchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalProcedure',
  name: 'Бесплатное второе мнение онколога-маммолога',
  description: 'Бесплатная проверка диагноза и снимков онкологом-маммологом для пациентов из любого региона России. Помогает спокойно перепроверить показания к операции и обсудить возможные варианты лечения.',
  procedureType: 'https://schema.org/DiagnosticProcedure',
  url: 'https://odintsovclinic.ru/second-opinion',
  bodyLocation: 'Молочная железа',
  followup: 'Консультация по результатам, при необходимости - направление на ВАБ',
  howPerformed: 'Анализ снимков, УЗИ и медицинской документации пациента специалистом-маммологом',
  preparation: 'Принесите имеющиеся снимки, результаты УЗИ и медицинские заключения',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'RUB',
    description: 'Бесплатно',
    seller: {
      '@type': 'MedicalClinic',
      name: 'Клиника Одинцова',
      url: 'https://odintsovclinic.ru',
      telephone: '+78127482210',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'пр. Богатырский, д. 22, к. 1',
        addressLocality: 'Санкт-Петербург',
        postalCode: '197374',
        addressCountry: 'RU',
      },
    },
  },
  recognizingAuthority: {
    '@type': 'MedicalOrganization',
    name: 'Клиника Одинцова',
  },
}

const faqSchema = generateFaqSchema(SECOND_OPINION_FAQ)
---

<Layout
  title="Бесплатное второе мнение онколога-маммолога для пациентов из России | Клиника Одинцова"
  description="Пациентам из любого региона России: онколог-маммолог бесплатно проверит снимки и заключение, а при необходимости пригласит на очный приём в Санкт-Петербурге."
  keywords="второе мнение маммолог, проверить диагноз, онколог-маммолог, Санкт-Петербург, Приморский район, бесплатная консультация"
>
  <script type="application/ld+json" set:html={JSON.stringify(secondOpinionSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <BreadcrumbNav items={[{ label: 'Бесплатное второе мнение' }]} />
  <SecondOpinion client:load />
</Layout>
