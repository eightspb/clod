---
import { getCollection, getEntry, render } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import { BreadcrumbNav } from '../../components/BreadcrumbNav.jsx'
import { DOCTORS } from '../../lib/doctors-data.js'
import { RING_COLOR_MAP } from '../../lib/constants.js'

export async function getStaticPaths() {
  const posts = await getCollection('blog')
  return posts.map((post) => ({ params: { slug: post.slug } }))
}

const { slug } = Astro.params
const post = await getEntry('blog', slug)
if (!post) return Astro.redirect('/blog')

const { Content } = await render(post)

const allPosts = await getCollection('blog')
const relatedPosts = allPosts
  .filter((p) => p.data.category === post.data.category && p.slug !== post.slug)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3)

const author = post.data.authorSlug
  ? DOCTORS.find((d) => d.slug === post.data.authorSlug)
  : null

const formattedDate = post.data.publishDate.toLocaleDateString('ru-RU', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
})

const updatedDate = post.data.updatedDate
  ? post.data.updatedDate.toLocaleDateString('ru-RU', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    })
  : null

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  headline: post.data.title,
  description: post.data.description,
  url: `https://odintsovclinic.ru/blog/${post.slug}`,
  datePublished: post.data.publishDate.toISOString(),
  ...(post.data.updatedDate && { dateModified: post.data.updatedDate.toISOString() }),
  author: author
    ? {
        '@type': 'Physician',
        name: author.name,
        url: `https://odintsovclinic.ru/doctors/${author.slug}`,
        jobTitle: author.specialization,
        worksFor: {
          '@type': 'MedicalBusiness',
          name: 'Клиника Одинцова',
          url: 'https://odintsovclinic.ru',
        },
      }
    : {
        '@type': 'Organization',
        name: 'Клиника Одинцова',
        url: 'https://odintsovclinic.ru',
      },
  publisher: {
    '@type': 'MedicalBusiness',
    name: 'Клиника Одинцова',
    url: 'https://odintsovclinic.ru',
    logo: {
      '@type': 'ImageObject',
      url: 'https://odintsovclinic.ru/images/logo.svg',
    },
  },
  medicalAudience: {
    '@type': 'MedicalAudience',
    audienceType: 'Patient',
  },
  ...(post.data.image && {
    image: {
      '@type': 'ImageObject',
      url: `https://odintsovclinic.ru${post.data.image}`,
      description: post.data.imageAlt ?? post.data.title,
    },
  }),
  inLanguage: 'ru',
  isPartOf: {
    '@type': 'Blog',
    name: 'Блог Клиники Одинцова',
    url: 'https://odintsovclinic.ru/blog',
  },
}

const breadcrumbItems = [
  { label: 'Блог', href: '/blog' },
  { label: post.data.title },
]
---

<Layout
  title={`${post.data.title} | Клиника Одинцова`}
  description={post.data.description}
  keywords={post.data.keywords}
  ogType="article"
  ogImage={post.data.image}
  ogImageAlt={post.data.imageAlt || post.data.title}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={post.data.publishDate.toISOString()} />
    <meta property="article:modified_time" content={post.data.updatedDate ? post.data.updatedDate.toISOString() : post.data.publishDate.toISOString()} />
    <meta property="article:author" content={author ? author.name : (post.data.author || 'Клиника Одинцова')} />
    {post.data.tags.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}
  </Fragment>

  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <BreadcrumbNav items={breadcrumbItems} />

  <div class="container-clay pb-20">
    <div class="blog-article-layout">

      <!-- Основной контент -->
      <article class="blog-article-main">
        <header class="mb-10">
          <div class="flex flex-wrap items-center gap-3 mb-5">
            <span class="blog-category-badge">
              {post.data.category}
            </span>
            {post.data.tags.map((tag) => (
              <span class="text-xs text-clay-muted bg-gray-100 px-2.5 py-1 rounded-full">
                #{tag}
              </span>
            ))}
          </div>

          <h1 class="text-2xl md:text-3xl lg:text-4xl font-bold text-clay-text leading-tight mb-5">
            {post.data.title}
          </h1>

          <p class="blog-lead">
            {post.data.description}
          </p>

          <div class="blog-meta">
            {author ? (
              <a href={`/doctors/${author.slug}`} class="flex items-center gap-2.5 hover:text-clay-teal transition-colors no-underline">
                <img
                  src={author.photo}
                  alt={author.name}
                  width="36"
                  height="36"
                  loading="lazy"
                  class="rounded-full object-cover w-9 h-9 ring-2 ring-white shadow-sm"
                />
                <div>
                  <span class="block font-semibold text-clay-text text-sm leading-tight">{author.name}</span>
                  <span class="block text-xs text-clay-muted leading-tight">{author.specialization}</span>
                </div>
              </a>
            ) : (
              <span class="font-medium text-clay-text text-sm">{post.data.author}</span>
            )}
            <span class="blog-meta-dot">·</span>
            <time datetime={post.data.publishDate.toISOString()} class="text-sm text-clay-muted">{formattedDate}</time>
            {updatedDate && (
              <>
                <span class="blog-meta-dot">·</span>
                <span class="text-sm text-clay-muted">Обновлено: {updatedDate}</span>
              </>
            )}
            {post.data.readingTime && (
              <>
                <span class="blog-meta-dot">·</span>
                <span class="text-sm text-clay-muted flex items-center gap-1">
                  <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                  {post.data.readingTime} мин
                </span>
              </>
            )}
          </div>
        </header>

        <div class="prose-clay">
          <Content />
        </div>

        <footer class="mt-14 pt-10 border-t border-gray-100">
          <div class="clay-card clay-card-mint p-8 md:p-10 text-center mt-8">
            <h2 class="text-xl font-bold text-white mb-3">Остались вопросы?</h2>
            <p class="text-white/85 mb-6 max-w-md mx-auto">
              Запишитесь на консультацию к специалисту - получите персональный ответ на вашу ситуацию.
            </p>
            <a href="/#appointment" class="btn-clay-white inline-block">
              Записаться на приём
            </a>
          </div>

          <div class="mt-8 text-center">
            <a href="/blog" class="text-clay-teal hover:underline text-sm font-medium">
              ← Все статьи блога
            </a>
          </div>
        </footer>
      </article>

      <!-- Боковая панель -->
      <aside class="blog-article-sidebar">
        {author && (
          <article class="clay clay-card p-6 flex flex-col relative overflow-visible group mb-5">
            <p class="text-xs font-medium text-clay-teal uppercase tracking-wide mb-3">Автор</p>
            
            {/* Decorative dots */}
            <div class="pointer-events-none absolute top-4 right-10 w-3 h-3 rounded-full opacity-50" style="background: #FAC8B0;"></div>
            <div class="pointer-events-none absolute top-10 right-5 w-2 h-2 rounded-full opacity-35" style="background: #A8D8F4;"></div>
            <div class="pointer-events-none absolute bottom-20 right-5 w-2.5 h-2.5 rounded-full opacity-45" style="background: #A0E4D4;"></div>

            {/* Top row: photo + experience badge */}
            <div class="flex items-start justify-between mb-4">
              <a href={`/doctors/${author.slug}`} class="no-underline block flex-shrink-0">
                <div class={`${RING_COLOR_MAP[author.ringColor] || 'avatar-ring-mint'} flex-shrink-0`}>
                  <img
                    src={author.photo}
                    alt={author.name}
                    width="192"
                    height="192"
                    loading="lazy"
                    class="rounded-full object-cover w-48 h-48"
                  />
                </div>
              </a>
              <div class="clay clay-card-soft-mint px-3 py-1.5 rounded-xl text-center flex-shrink-0 mt-2">
                <p class="text-xs text-clay-muted leading-none mb-0.5">Стаж</p>
                <p class="text-sm font-extrabold text-clay-mint leading-none">{author.experienceYears} лет</p>
              </div>
            </div>

            {/* Name */}
            <a href={`/doctors/${author.slug}`} class="no-underline block">
              <h4 class="font-bold text-clay-dark text-base leading-snug mb-2 group-hover:text-clay-teal transition-colors">{author.name}</h4>
            </a>

            {/* Specialization + link */}
            <div class="mt-auto pt-3 border-t border-clay-bg flex items-center justify-between gap-2">
              <div class="clay clay-card-soft-blue px-3 py-1.5 rounded-xl min-w-0 flex-1 mr-2">
                <p class="text-xs font-semibold text-clay-dark leading-tight truncate">
                  {author.specialization.split(',')[0]}
                </p>
                {author.specialization.split(',')[1] && (
                  <p class="text-xs text-clay-muted leading-tight truncate">
                    {author.specialization.split(',').slice(1).join(',').trim()}
                  </p>
                )}
              </div>
              <a
                href={`/doctors/${author.slug}`}
                class="clay btn-clay-primary text-xs py-2 px-4 gap-1 flex-shrink-0 no-underline"
              >
                Подробнее
              </a>
            </div>
          </article>
        )}

        <div class="clay-card clay-card-soft-mint p-5 mb-5">
          <p class="text-xs font-medium text-clay-teal uppercase tracking-wide mb-3">Запись на приём</p>
          <p class="text-sm text-clay-muted mb-4 leading-relaxed">Получите консультацию специалиста по вашей ситуации</p>
          <a href="/#appointment" class="btn-clay-primary block text-center text-sm py-2.5">
            Записаться
          </a>
        </div>

        <div class="clay-card p-5 mb-5">
          <p class="text-xs font-medium text-clay-muted uppercase tracking-wide mb-3">Категория</p>
          <span class="blog-category-badge">{post.data.category}</span>
          {post.data.tags.length > 0 && (
            <div class="flex flex-wrap gap-1.5 mt-3">
              {post.data.tags.map((tag) => (
                <span class="text-xs text-clay-muted bg-gray-100 px-2 py-0.5 rounded-full">#{tag}</span>
              ))}
            </div>
          )}
        </div>

        {relatedPosts.length > 0 && (
          <div class="clay-card p-5">
            <p class="text-xs font-medium text-clay-teal uppercase tracking-wide mb-4">Читайте также</p>
            <div class="flex flex-col gap-4">
              {relatedPosts.map((related) => (
                <a href={`/blog/${related.slug}`} class="group no-underline block">
                  <h4 class="text-sm font-bold text-clay-text group-hover:text-clay-teal transition-colors leading-snug mb-1.5 line-clamp-2">
                    {related.data.title}
                  </h4>
                  <time class="text-xs text-clay-muted block">
                    {related.data.publishDate.toLocaleDateString('ru-RU', {
                      day: 'numeric',
                      month: 'long',
                      year: 'numeric'
                    })}
                  </time>
                </a>
              ))}
            </div>
          </div>
        )}
      </aside>

    </div>
  </div>
</Layout>
