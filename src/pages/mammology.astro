---
import Layout from '../layouts/Layout.astro'
import { Mammology } from '../components/pages/Mammology.jsx'
import { BreadcrumbNav } from '../components/BreadcrumbNav.jsx'

const specialtySchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalClinic',
  name: 'Клиника Одинцова - Маммология',
  medicalSpecialty: 'Oncology',
  availableService: {
    '@type': 'MedicalProcedure',
    name: 'Вакуумная аспирационная биопсия (ВАБ)',
  },
  isPartOf: { '@type': 'MedicalBusiness', name: 'Клиника Одинцова' },
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'пр. Богатырский, д. 22, к. 1',
    addressLocality: 'Санкт-Петербург',
    postalCode: '197374',
    addressRegion: 'Санкт-Петербург',
    addressCountry: 'RU',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 60.0028,
    longitude: 30.2153,
  },
}
---

<Layout
  title="Маммология в Санкт-Петербурге - ВАБ и лечение молочных желёз | Клиника Одинцова"
  description="Удаление новообразований груди через прокол 2 мм. Технология ВАБ EnCor Enspire - без скальпеля, без общего наркоза. Процедура 30 минут. Бесплатное второе мнение."
  keywords="маммолог Санкт-Петербург, маммолог СПб, ВАБ СПб, вакуумная аспирационная биопсия Санкт-Петербург, удаление фиброаденомы без операции, удаление кисты молочной железы, маммолог Комендантский проспект, маммолог Старая Деревня"
>
  <script type="application/ld+json" set:html={JSON.stringify(specialtySchema)} />
  <BreadcrumbNav items={[{ label: 'Маммология' }]} />
  <Mammology />
</Layout>
