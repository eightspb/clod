---
import { getCollection } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import { BreadcrumbNav } from '../../components/BreadcrumbNav.jsx'
import { ArrowRight, CalendarDays, ChevronLeft, ChevronRight, Clock3, ExternalLink, MessageCircle, Play, Tv, UserRound } from 'lucide-react'

function normalizeImageUrl(image) {
  if (!image) return '/images/og-default.jpg'
  if (image.startsWith('http://') || image.startsWith('https://')) return image
  if (image.startsWith('/')) return image
  const normalizedImage = image.replace(/^\/?/, '')
  return normalizedImage.startsWith('images/')
    ? `/${normalizedImage}`
    : `/images/${normalizedImage}`
}

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
)

const CATEGORY_SOFT_COLORS = {
  'Маммология':       'clay-card-soft-mint',
  'Диагностика':      'clay-card-soft-blue',
  'Эндокринология':   'clay-card-soft-peach',
  'Гинекология':      'clay-card-soft-lavender',
  'Нутрициология':    'clay-card-soft-lavender',
  'Неврология':       'clay-card-soft-blue',
  'События клиники':  'clay-card-soft-peach',
  'Клинические случаи': 'clay-card-soft-mint',
  'Видео':            'clay-card-soft-blue',
}

const CATEGORY_ACCENT = {
  'Маммология':       'text-emerald-700 bg-emerald-50/90',
  'Диагностика':      'text-sky-700 bg-sky-50/90',
  'Эндокринология':   'text-orange-700 bg-orange-50/90',
  'Гинекология':      'text-violet-700 bg-violet-50/90',
  'Нутрициология':    'text-violet-700 bg-violet-50/90',
  'Неврология':       'text-sky-700 bg-sky-50/90',
  'События клиники':  'text-orange-700 bg-orange-50/90',
  'Клинические случаи': 'text-emerald-700 bg-emerald-50/90',
  'Видео':            'text-sky-700 bg-sky-50/90',
}

const FALLBACK_COLORS = [
  'clay-card-soft-mint',
  'clay-card-soft-peach',
  'clay-card-soft-blue',
  'clay-card-soft-lavender',
]


const ALL_CATEGORIES = ['Все', 'Маммология', 'Гинекология', 'Эндокринология', 'Нутрициология', 'Диагностика', 'События клиники', 'Клинические случаи', 'Видео']

const TV_VIDEOS = [
  {
    title: 'Одинцов о ВАБ на телевидении',
    desc: 'Интервью о вакуумно-аспирационной биопсии и маршруте пациентки.',
    channel: 'ТВ-эфир',
    date: '2025',
  },
  {
    title: 'Маммология без мифов',
    desc: 'Комментарий врача о распространённых мифах и клинической практике.',
    channel: 'ТВ-эфир',
    date: '2025',
  },
  {
    title: 'Гормоны под контролем',
    desc: 'Как работает щитовидная железа и когда имеет смысл обследование.',
    channel: 'ТВ-эфир',
    date: '2025',
  },
  {
    title: 'Женское здоровье после 40',
    desc: 'Как меняются задачи профилактики и наблюдения в зрелом возрасте.',
    channel: 'ТВ-эфир',
    date: '2025',
  }
]

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Блог Клиники Одинцова',
  description: 'Статьи о маммологии, гинекологии, эндокринологии и нутрициологии от врачей клиники',
  url: 'https://odintsovclinic.ru/blog',
  numberOfItems: posts.length,
  itemListElement: posts.map((post, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: `https://odintsovclinic.ru/blog/${post.slug}`,
    name: post.data.title,
  })),
  publisher: {
    '@type': 'MedicalBusiness',
    name: 'Клиника Одинцова',
    url: 'https://odintsovclinic.ru',
  },
  spatialCoverage: {
    '@type': 'Place',
    name: 'Санкт-Петербург',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Санкт-Петербург',
      addressRegion: 'Санкт-Петербург',
      addressCountry: 'RU',
    },
  },
}
---

<Layout
  title="Блог и клинические разборы | Клиника Одинцова"
  description="Статьи, клинические разборы и ответы врачей Клиники Одинцова. Полезные материалы по маммологии, гинекологии и эндокринологии."
  keywords="блог клиники, клинические разборы, статьи о маммологии, статьи о гинекологии, статьи об эндокринологии, диагностика"
  canonicalUrl="https://odintsovclinic.ru/blog"
  ogImage="/images/og/blog.webp"
>
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />

  <BreadcrumbNav items={[{ label: 'Блог' }]} />

  <div class="container-clay pb-20">
    <section class="pt-4 pb-10">
      <div class="grid gap-6 lg:grid-cols-[minmax(0,1.15fr)_minmax(280px,0.85fr)] lg:items-end">
        <div>
          <h1 class="text-4xl sm:text-5xl md:text-6xl heading-display text-clay-dark mb-4">
            Блог и клинические разборы
          </h1>
          <p class="text-clay-muted text-lg md:text-xl max-w-3xl leading-relaxed">
            Статьи, клинические случаи и комментарии врачей. Разбираем медицинские темы спокойно и точно, без лишнего рекламного тона.
          </p>
        </div>
        <div class="clay-card p-5 md:p-6">
          <p class="text-sm font-semibold text-clay-dark mb-2">Как пользоваться разделом</p>
          <p class="text-sm text-clay-muted leading-relaxed">
            Выберите тему, прочитайте материал и при необходимости перейдите к очной маршрутизации в Санкт-Петербурге.
          </p>
        </div>
      </div>
    </section>

    <section class="mb-14">
      <div class="flex items-end justify-between gap-4 mb-5">
        <div class="max-w-2xl">
          <h2 class="text-2xl sm:text-3xl heading-serif text-clay-dark mb-2">Выступления врачей в медиа</h2>
          <p class="text-sm text-clay-muted leading-relaxed">
            Короткие темы эфиров и интервью, где врачи объясняют диагностику и маршрут пациента простым языком.
          </p>
        </div>
        <div class="hidden sm:flex gap-2">
          <button type="button" id="prev-video-btn" aria-label="Предыдущее видео" class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-[color:var(--border-color)] bg-[color:var(--surface-card)] text-clay-muted shadow-[var(--shadow-xs)] transition-colors hover:text-clay-teal">
            <ChevronLeft size={17} aria-hidden="true" />
          </button>
          <button type="button" id="next-video-btn" aria-label="Следующее видео" class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-[color:var(--border-color-strong)] bg-[color:var(--surface-card)] text-clay-teal shadow-[var(--shadow-xs)] transition-colors hover:bg-[color:var(--surface-muted)]">
            <ChevronRight size={17} aria-hidden="true" />
          </button>
        </div>
      </div>
      <div id="video-carousel" class="flex gap-4 overflow-x-auto snap-x snap-mandatory pb-5 [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden -mx-4 px-4 sm:mx-0 sm:px-0 scroll-smooth">
        {TV_VIDEOS.map((video) => (
          <article class="clay-card p-5 md:p-6 min-w-[280px] w-[86%] sm:w-[360px] lg:w-[400px] snap-center flex-shrink-0 transition-transform duration-200 hover:-translate-y-0.5">
            <div class="flex items-start gap-4">
              <div class="icon-circle-blue h-11 w-11 rounded-[16px]">
                <Tv size={19} className="text-white" aria-hidden="true" />
              </div>
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2 mb-3">
                  <span class="rounded-full bg-sky-50 px-3 py-1 text-xs font-semibold text-sky-700">{video.channel}</span>
                  <span class="text-xs font-medium text-clay-muted">{video.date}</span>
                </div>
                <h3 class="font-bold text-clay-dark text-lg leading-snug mb-2">{video.title}</h3>
                <p class="text-sm text-clay-muted leading-relaxed mb-4">{video.desc}</p>
                <p class="inline-flex items-center gap-2 text-xs font-semibold text-clay-teal">
                  <Play size={13} aria-hidden="true" />
                  Видео скоро появится
                </p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <div class="mb-10">
      <p class="text-sm font-semibold text-clay-dark mb-3">Фильтр по теме</p>
      <div class="flex flex-wrap gap-2.5" id="category-filters">
        {ALL_CATEGORIES.map((cat, i) => (
          <button
            type="button"
            data-filter={cat}
            aria-pressed={i === 0}
            class={`category-filter-btn inline-flex items-center px-4 py-2 rounded-full text-sm font-semibold cursor-pointer transition-all hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-clay-mint/40 focus-visible:ring-offset-2 ${
              i === 0 ? 'active-filter' : ''
            }`}
          >
            {cat}
          </button>
        ))}
      </div>
    </div>

    <section class="mb-16">
      <div class="max-w-2xl mb-7">
        <h2 class="text-2xl sm:text-3xl heading-serif text-clay-dark mb-2">Статьи и клинические случаи</h2>
        <p class="text-sm text-clay-muted leading-relaxed">
          Материалы сгруппированы по темам, но каждый текст сохраняет самостоятельный маршрут чтения.
        </p>
      </div>
      {posts.length === 0 ? (
        <div class="p-12 text-center clay-card clay-card-soft-mint">
          <p class="text-clay-dark font-medium text-lg">Статьи скоро появятся.</p>
        </div>
      ) : (
        <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {posts.map((post, index) => {
            const cardColor = CATEGORY_SOFT_COLORS[post.data.category] ?? FALLBACK_COLORS[index % FALLBACK_COLORS.length]
            const accentClass = CATEGORY_ACCENT[post.data.category] ?? 'text-clay-teal bg-teal-50/90'
            const isFeatured = index === 0
            const formattedDate = post.data.publishDate.toLocaleDateString('ru-RU', {
              day: 'numeric',
              month: 'long',
              year: 'numeric',
            })
            
            return (
              <a
                href={`/blog/${post.slug}`}
                data-post-card
                data-category={post.data.category}
                class={`${cardColor} clay-card flex flex-col p-0 overflow-hidden hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 no-underline group border border-white/40 ${isFeatured ? 'lg:col-span-2 lg:grid lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)]' : ''}`}
              >
                <div class={`w-full overflow-hidden relative bg-gray-100 ${isFeatured ? 'h-56 lg:h-full lg:min-h-[320px]' : 'h-52'}`}>
                  <img
                    src={normalizeImageUrl(post.data.image)}
                    alt={post.data.imageAlt || post.data.title}
                    width="800"
                    height="420"
                    loading="lazy"
                    class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-500 ease-out"
                  />
                  <div class="absolute left-4 top-4 flex items-center gap-2">
                    <span class={`text-xs font-semibold px-3 py-1 rounded-full shadow-sm bg-white/95 ${accentClass}`}>
                      {post.data.category}
                    </span>
                  </div>
                </div>
                <div class="p-6 md:p-7 flex flex-col flex-1">
                  <div class="flex flex-wrap items-center gap-2.5 mb-4">
                    <span class="text-xs font-semibold text-clay-muted flex items-center gap-1.5 bg-white/55 px-2.5 py-1 rounded-full">
                      <CalendarDays size={13} aria-hidden="true" />
                      {formattedDate}
                    </span>
                    {post.data.readingTime && (
                      <span class="text-xs font-semibold text-clay-muted flex items-center gap-1.5 bg-white/55 px-2.5 py-1 rounded-full">
                        <Clock3 size={13} aria-hidden="true" />
                        {post.data.readingTime} мин
                      </span>
                    )}
                  </div>
                  
                  <h2 class={`${isFeatured ? 'text-2xl md:text-3xl' : 'text-xl'} font-extrabold text-clay-dark mb-3 leading-snug line-clamp-3 group-hover:text-clay-teal transition-colors`}>
                    {post.data.title}
                  </h2>
                  
                  <p class="text-sm text-clay-text mb-6 line-clamp-3 leading-relaxed opacity-90">
                    {post.data.description}
                  </p>
                  
                  <div class="mt-auto pt-5 border-t border-black/5 flex items-center justify-between">
                    <span class="text-sm font-bold text-clay-teal group-hover:translate-x-1.5 transition-transform duration-300 flex items-center gap-1.5">
                      Читать статью
                      <ArrowRight size={15} aria-hidden="true" />
                    </span>
                  </div>
                </div>
              </a>
            )
          })}
        </div>
      )}
    </section>

    <div class="grid gap-5 md:grid-cols-2 mb-10">
      <div class="clay-card-soft-mint clay-card p-6 md:p-8">
        <div class="flex items-start gap-4">
          <div class="icon-circle-mint h-12 w-12 rounded-[16px]">
            <UserRound size={20} className="text-white" aria-hidden="true" />
          </div>
          <div>
            <h2 class="text-2xl heading-serif text-clay-dark mb-2">Личный кабинет пациента</h2>
            <p class="text-clay-muted mb-5 text-sm leading-relaxed">
              Если вы уже пользуетесь внешним сервисом МедТочка, здесь можно авторизоваться и перейти к своим данным.
            </p>
          </div>
        </div>
        <a href="https://app.medtochka.ru/authorization/?preselected_country=RU" class="btn-clay-primary inline-flex items-center gap-2.5 px-7 py-3 text-sm w-full sm:w-auto justify-center">
          Открыть МедТочку
          <ExternalLink size={15} aria-hidden="true" />
        </a>
      </div>
      
      <div class="clay-card p-6 md:p-8">
        <div class="flex items-start gap-4">
          <div class="icon-circle-blue h-12 w-12 rounded-[16px]">
            <MessageCircle size={20} className="text-white" aria-hidden="true" />
          </div>
          <div>
            <h2 class="text-2xl heading-serif text-clay-dark mb-2">Нужна очная консультация?</h2>
            <p class="text-clay-muted mb-5 text-sm leading-relaxed">
              Если вы в Санкт-Петербурге, подскажем профильного специалиста и удобное время визита.
            </p>
          </div>
        </div>
        <button type="button" data-booking-btn="true" class="btn-clay-secondary inline-flex items-center gap-2.5 px-7 py-3 text-sm w-full sm:w-auto justify-center">
          Записаться на приём
        </button>
      </div>
    </div>

  </div>

  <style is:global>
    .category-filter-btn {
      background: rgba(255, 255, 255, 0.82);
      color: #27453f;
      border: 1px solid rgba(47, 143, 124, 0.18);
      box-shadow: 0 8px 18px rgba(36, 55, 51, 0.04);
    }
    .category-filter-btn.active-filter {
      background: #27453f;
      color: white;
      border-color: #27453f;
    }
    .category-filter-btn:focus-visible {
      outline: none;
      box-shadow: 0 0 0 3px rgba(47, 143, 124, 0.22);
    }
  </style>

  <script>
    function setupBlogInteractions() {
      const filterBtns = document.querySelectorAll('.category-filter-btn');
      const postCards = document.querySelectorAll('[data-post-card]');
      if (filterBtns.length > 0 && postCards.length > 0) {
        filterBtns.forEach(btn => {
          btn.onclick = () => {
            filterBtns.forEach(b => b.classList.remove('active-filter'));
            filterBtns.forEach(b => b.setAttribute('aria-pressed', 'false'));
            btn.classList.add('active-filter');
            btn.setAttribute('aria-pressed', 'true');
            const selectedCategory = btn.getAttribute('data-filter');
            postCards.forEach(card => {
              const cardCategory = card.getAttribute('data-category');
              if (selectedCategory === 'Все' || cardCategory === selectedCategory) {
                card.style.display = '';
              } else {
                card.style.display = 'none';
              }
            });
          };
        });
      }
      const videoCarousel = document.getElementById('video-carousel');
      const prevBtn = document.getElementById('prev-video-btn');
      const nextBtn = document.getElementById('next-video-btn');
      if (videoCarousel && prevBtn && nextBtn) {
        prevBtn.onclick = () => {
          const cardWidth = videoCarousel.firstElementChild?.clientWidth || 350;
          const gap = 20;
          videoCarousel.scrollBy({ left: -(cardWidth + gap), behavior: 'smooth' });
        };

        nextBtn.onclick = () => {
          const cardWidth = videoCarousel.firstElementChild?.clientWidth || 350;
          const gap = 20;
          videoCarousel.scrollBy({ left: (cardWidth + gap), behavior: 'smooth' });
        };
      }
    }
    setupBlogInteractions();
    document.addEventListener('astro:page-load', setupBlogInteractions);
  </script>
</Layout>
