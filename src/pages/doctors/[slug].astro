---
import Layout from '../../layouts/Layout.astro'
import { DoctorPage } from '../../components/pages/DoctorPage.jsx'
import { BreadcrumbNav } from '../../components/BreadcrumbNav.jsx'
import { DOCTORS, getDoctorBySlug } from '../../lib/doctors-data.js'

export function getStaticPaths() {
  return DOCTORS.map((doctor) => ({
    params: { slug: doctor.slug },
  }))
}

const { slug } = Astro.params
const doctor = getDoctorBySlug(slug)

if (!doctor) {
  return Astro.redirect('/doctors')
}

const doctorUrl = `https://odintsovclinic.ru/doctors/${doctor.slug}`

const sameAsLinks = [
  ...(doctor.proDoctorovUrl ? [doctor.proDoctorovUrl] : []),
]

const hasCredential = doctor.education
  ? doctor.education.map((edu) => ({
      "@type": "EducationalOccupationalCredential",
      "name": edu.description,
      "dateCreated": edu.year,
    }))
  : []

const physicianSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${doctorUrl}#person`,
  "name": doctor.name,
  "description": doctor.tagline || doctor.bio || '',
  "jobTitle": doctor.specialization,
  ...(doctor.degree ? { "honorificSuffix": doctor.degree } : {}),
  "knowsAbout": doctor.helpsWith || [],
  "worksFor": {
    "@id": "https://odintsovclinic.ru/#clinic",
    "@type": "MedicalBusiness",
    "name": "Клиника Одинцова",
    "url": "https://odintsovclinic.ru",
      "address": {
      "@type": "PostalAddress",
      "streetAddress": "пр. Богатырский, д. 22, к. 1",
      "addressLocality": "Санкт-Петербург",
      "addressRegion": "Санкт-Петербург",
      "postalCode": "197374",
      "addressCountry": "RU"
    }
  },
  "url": doctorUrl,
  ...(doctor.photo ? { "image": `https://odintsovclinic.ru${doctor.photo}` } : {}),
  ...(sameAsLinks.length > 0 ? { "sameAs": sameAsLinks } : {}),
  ...(hasCredential.length > 0 ? { "hasCredential": hasCredential } : {}),

}
---

<Layout
  title={`${doctor.name} — ${doctor.specialization.split(',')[0].toLowerCase()} в СПб`}
  description={`${doctor.name}: ${doctor.specialization.toLowerCase()}. Стаж ${doctor.experienceYears} лет. Запись в клинику Одинцова на Богатырском проспекте, 22 к. 1.`}
  keywords={`${doctor.name}, ${doctor.specialization} Санкт-Петербург, ${doctor.specialization} СПб, клиника Одинцова врачи`}
  canonicalUrl={doctorUrl}
  ogType="profile"
  pageType="ProfilePage"
  mainEntityId={`${doctorUrl}#person`}
  ogImage={doctor.photo}
  ogImageAlt={doctor.name}
  pageDoctorSlug={doctor.slug}
>
  <script type="application/ld+json" set:html={JSON.stringify(physicianSchema)} />
  <BreadcrumbNav items={[{ label: 'Доктора', href: '/doctors' }, { label: doctor.name }]} />
  <DoctorPage doctor={doctor} />
</Layout>
