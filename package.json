{
  "name": "klinika-odincova",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "powershell -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "build": "astro build && node scripts/async-about-css.mjs",
