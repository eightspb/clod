---
import { getCollection } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import { BreadcrumbNav } from '../../components/BreadcrumbNav.jsx'

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
)

const CATEGORY_SOFT_COLORS = {
  'Маммология':    'clay-card-soft-mint',
  'Диагностика':   'clay-card-soft-blue',
  'Эндокринология':'clay-card-soft-peach',
  'Гинекология':   'clay-card-soft-lavender',
  'Неврология':    'clay-card-soft-blue',
}

const CATEGORY_ACCENT = {
  'Маммология':    'text-emerald-700 bg-emerald-50',
  'Диагностика':   'text-sky-700 bg-sky-50',
  'Эндокринология':'text-orange-700 bg-orange-50',
  'Гинекология':   'text-violet-700 bg-violet-50',
  'Неврология':    'text-sky-700 bg-sky-50',
}

const FALLBACK_COLORS = [
  'clay-card-soft-mint',
  'clay-card-soft-peach',
  'clay-card-soft-blue',
  'clay-card-soft-lavender',
]

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Блог Клиники Одинцова',
  description: 'Статьи о маммологии, гинекологии, эндокринологии и неврологии от врачей клиники',
  url: 'https://odintsovclinic.ru/blog',
  numberOfItems: posts.length,
  itemListElement: posts.map((post, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: `https://odintsovclinic.ru/blog/${post.slug}`,
    name: post.data.title,
  })),
  publisher: {
    '@type': 'MedicalBusiness',
    name: 'Клиника Одинцова',
    url: 'https://odintsovclinic.ru',
  },
  spatialCoverage: {
    '@type': 'Place',
    name: 'Санкт-Петербург',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Санкт-Петербург',
      addressRegion: 'Санкт-Петербург',
      addressCountry: 'RU',
    },
  },
}
---

<Layout
  title="Блог - статьи о здоровье | Клиника Одинцова"
  description="Полезные статьи о маммологии, гинекологии, эндокринологии и неврологии от врачей Клиники Одинцова в Санкт-Петербурге. Советы специалистов, ответы на частые вопросы."
  keywords="блог клиника Одинцова, статьи о маммологии СПб, статьи о гинекологии Санкт-Петербург, статьи о щитовидной железе, советы маммолога СПб, гинеколог СПб, эндокринолог СПб"
  canonicalUrl="https://odintsovclinic.ru/blog"
>
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />

  <BreadcrumbNav items={[{ label: 'Блог' }]} />

  <div class="container-clay pb-20">

    <div class="mb-10">
      <h1 class="text-3xl md:text-4xl font-bold text-clay-text mb-4">
        Блог клиники
      </h1>
      <p class="text-clay-muted text-lg max-w-2xl">
        Статьи о здоровье от врачей Клиники Одинцова. Разбираем сложные медицинские темы простым языком.
      </p>
    </div>

    {posts.length === 0 ? (
      <p class="text-clay-muted">Статьи скоро появятся.</p>
    ) : (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post, index) => {
          const cardColor = CATEGORY_SOFT_COLORS[post.data.category] ?? FALLBACK_COLORS[index % FALLBACK_COLORS.length]
          const accentClass = CATEGORY_ACCENT[post.data.category] ?? 'text-clay-teal bg-teal-50'
          const formattedDate = post.data.publishDate.toLocaleDateString('ru-RU', {
            day: 'numeric',
            month: 'long',
            year: 'numeric',
          })
          return (
            <a
              href={`/blog/${post.slug}`}
              class={`${cardColor} clay-card flex flex-col p-6 hover:scale-[1.02] transition-transform duration-200 no-underline group`}
            >
              <div class="flex items-center gap-2 mb-4">
                <span class={`text-xs font-semibold px-2.5 py-1 rounded-full ${accentClass}`}>
                  {post.data.category}
                </span>
                {post.data.readingTime && (
                  <span class="text-xs text-clay-muted">{post.data.readingTime} мин</span>
                )}
              </div>
              <h2 class="text-base font-bold text-clay-dark mb-2 leading-snug line-clamp-3 flex-1">
                {post.data.title}
              </h2>
              <p class="text-sm text-clay-text mb-5 line-clamp-2 leading-relaxed opacity-80">
                {post.data.description}
              </p>
              <div class="flex items-center justify-between mt-auto pt-3 border-t border-black/5">
                <span class="text-xs text-clay-muted">{formattedDate}</span>
                <span class="text-xs font-semibold text-clay-mint group-hover:translate-x-0.5 transition-transform duration-150">
                  Читать →
                </span>
              </div>
            </a>
          )
        })}
      </div>
    )}

    <div class="mt-16 clay-card-soft-mint clay-card p-8 md:p-10 text-center">
      <h2 class="text-xl font-bold text-clay-dark mb-3">Есть вопрос к врачу?</h2>
      <p class="text-clay-muted mb-6 max-w-md mx-auto">
        Запишитесь на консультацию - наши специалисты ответят на все вопросы лично.
      </p>
      <a href="/#appointment" class="btn-clay-primary inline-block">
        Записаться на приём
      </a>
    </div>

  </div>
</Layout>
