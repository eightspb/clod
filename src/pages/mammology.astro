---
import Layout from '../layouts/Layout.astro'
import ServiceArticles from '../components/ServiceArticles.astro'
import { Mammology, MAMMOLOGY_FAQ } from '../components/pages/Mammology.jsx'
import { BreadcrumbNav } from '../components/BreadcrumbNav.jsx'
import { generateFaqSchema } from '../utils/schema.js'

const specialtySchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': 'https://odintsovclinic.ru/mammology#service',
  name: 'Приём маммолога в Санкт-Петербурге',
  url: 'https://odintsovclinic.ru/mammology',
  provider: { '@id': 'https://odintsovclinic.ru/#clinic' },
  areaServed: { '@type': 'City', name: 'Санкт-Петербург' },
}

const faqSchema = generateFaqSchema(MAMMOLOGY_FAQ)
---

<Layout
  pageType="MedicalWebPage"
  title="Маммолог в СПб — приём, УЗИ, цены | Клиника Одинцова"
  description="Приём онколога-маммолога в Приморском районе Санкт-Петербурга: осмотр, УЗИ, биопсия и второе мнение. Врачи, цены и запись в клинику Одинцова."
  keywords="маммолог Санкт-Петербург, маммология СПб, ВАБ Санкт-Петербург, фиброаденома, киста молочной железы, Приморский район, Богатырский проспект"
  ogImage="/images/og/mammology.webp"
>
  <script type="application/ld+json" set:html={JSON.stringify(specialtySchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <BreadcrumbNav items={[{ label: 'Маммология' }]} />
  <Mammology client:idle />
  <ServiceArticles articles={[
    { slug: 'kak-prokhodit-uzi-molochnyh-zhelez', title: 'Как проходит УЗИ молочных желёз' },
    { slug: 'mammografiya-ili-uzi', title: 'Маммография или УЗИ молочных желёз: что выбрать' },
    { slug: 'zdorovye-grudi-samoosmotr', title: 'Как заботиться о здоровье молочной железы: самоосмотр и скрининг' },
  ]} />
</Layout>
