---
import Layout from '../layouts/Layout.astro'
import { BreadcrumbNav } from '../components/BreadcrumbNav.jsx'
import { ArrowRight, Home, Search } from 'lucide-react'
---

<Layout
  title="Страница не найдена - Клиника Одинцова"
  description="Страница не найдена. Вернитесь на главную страницу Клиники Одинцова."
>
  <BreadcrumbNav items={[{ label: 'Страница не найдена' }]} />
  <section class="container-clay py-16 md:py-20">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,0.95fr)_minmax(320px,0.75fr)] lg:items-center">
      <div>
        <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border-color)] bg-[color:var(--surface-card)] px-4 py-2 text-sm font-semibold text-clay-dark shadow-[var(--shadow-xs)] mb-6">
          <Search size={14} aria-hidden="true" />
          404
        </div>
        <h1 class="text-4xl sm:text-5xl heading-display text-clay-dark leading-tight mb-4">
          Страница не найдена
        </h1>
        <p class="text-lg text-clay-muted leading-relaxed mb-7 max-w-2xl">
          Возможно, ссылка устарела или страница была перемещена. Вернитесь к основным разделам клиники или выберите врача.
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="/" class="btn-clay-primary inline-flex items-center gap-2 justify-center">
            <Home size={16} aria-hidden="true" />
            На главную
          </a>
          <a href="/doctors" class="btn-clay-secondary inline-flex items-center gap-2 justify-center">
            Выбрать врача
            <ArrowRight size={16} aria-hidden="true" />
          </a>
        </div>
      </div>

      <div class="clay-card p-5 md:p-6">
        <p class="text-sm font-semibold text-clay-dark mb-4">Популярные разделы</p>
        <div class="grid gap-2">
          {[
            { label: 'Маммология', href: '/mammology' },
            { label: 'ВАБ', href: '/vab' },
            { label: 'Гинекология', href: '/gynecology' },
            { label: 'Эндокринология', href: '/endocrinology' },
            { label: 'Нутрициология', href: '/nutrition' },
            { label: 'Бесплатное второе мнение', href: '/second-opinion' },
          ].map((link) => (
            <a
              href={link.href}
              class="group flex items-center justify-between rounded-[16px] border border-[color:var(--border-color)] bg-[color:var(--surface-muted)] px-4 py-3 text-sm font-medium text-clay-text transition-colors hover:text-clay-teal"
            >
              <span>{link.label}</span>
              <ArrowRight size={14} className="text-clay-muted transition-transform group-hover:translate-x-0.5 group-hover:text-clay-teal" aria-hidden="true" />
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
</Layout>
