---
import Layout from '../layouts/Layout.astro'
import ServiceArticles from '../components/ServiceArticles.astro'
import { Endometrioz, ENDOMETRIOZ_FAQ } from '../components/pages/Endometrioz.jsx'
import { BreadcrumbNav } from '../components/BreadcrumbNav.jsx'
import { generateFaqSchema } from '../utils/schema.js'

const conditionSchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalCondition',
  '@id': 'https://odintsovclinic.ru/endometrioz#condition',
  url: 'https://odintsovclinic.ru/endometrioz',
  name: 'Эндометриоз',
  alternateName: 'Endometriosis',
  description: 'Заболевание, при котором ткань, подобная эндометрию, разрастается за пределами полости матки: на яичниках, маточных трубах, брюшине. Вызывает хроническую тазовую боль и может приводить к бесплодию.',
  associatedAnatomy: {
    '@type': 'AnatomicalStructure',
    name: 'Органы малого таза',
  },
  signOrSymptom: [
    { '@type': 'MedicalSymptom', name: 'Дисменорея (болезненные менструации)' },
    { '@type': 'MedicalSymptom', name: 'Хроническая тазовая боль' },
    { '@type': 'MedicalSymptom', name: 'Диспареуния (боль при половом контакте)' },
    { '@type': 'MedicalSymptom', name: 'Бесплодие' },
  ],
  possibleTreatment: [
    {
      '@type': 'MedicalTherapy',
      name: 'Гормональная терапия (КОК, прогестины, агонисты ГнРГ)',
    },
    {
      '@type': 'MedicalTherapy',
      name: 'Лапароскопическое удаление очагов эндометриоза',
    },
  ],
}

const faqSchema = generateFaqSchema(ENDOMETRIOZ_FAQ)
---

<Layout
  pageType="MedicalWebPage"
  mainEntityId="https://odintsovclinic.ru/endometrioz#condition"
  title="Эндометриоз — консультация гинеколога в СПб"
  description="Приём гинеколога при эндометриозе в Санкт-Петербурге. Разбор симптомов и результатов обследования, обсуждение тактики лечения. Врачи и цены клиники Одинцова."
  keywords="эндометриоз лечение СПб, гинеколог Санкт-Петербург, эндометриоз симптомы, тазовая боль, лапароскопия эндометриоз, Приморский район СПб"
  ogImage="/images/og/endometrioz.webp"
>
  <script type="application/ld+json" set:html={JSON.stringify(conditionSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <BreadcrumbNav items={[{ label: 'Гинекология', href: '/gynecology' }, { label: 'Эндометриоз' }]} />
  <Endometrioz client:idle />
  <ServiceArticles articles={[
    { slug: 'endometrioz-prichiny-simptomy', title: 'Эндометриоз: причины, симптомы и современные подходы к лечению' },
    { slug: 'endometrioz-vs-rak-endometriya', title: 'Эндометриоз или рак эндометрия: в чём разница и как не пропустить опасное' },
    { slug: 'tazovye-boli-u-zhenshchin', title: 'Тазовые боли у женщин: 6 причин, которые нельзя игнорировать' },
  ]} />
</Layout>
