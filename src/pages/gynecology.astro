---
export const prerender = false
import Layout from '../layouts/Layout.astro'
import { Gynecology, GYNECOLOGY_FAQ } from '../components/pages/Gynecology.jsx'
import { BreadcrumbNav } from '../components/BreadcrumbNav.jsx'
import { generateFaqSchema } from '../utils/schema.js'
import { db, Service } from '../lib/database.js'
import { eq } from '../lib/database.js'

const services = await db.select().from(Service).where(eq(Service.direction, 'Гинекология'));

const specialtySchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalClinic',
  name: 'Клиника Одинцова - Гинекология',
  medicalSpecialty: 'Gynecology',
  availableService: {
    '@type': 'MedicalProcedure',
    name: 'Гинекологический осмотр и УЗИ малого таза',
  },
  isPartOf: { '@type': 'MedicalBusiness', name: 'Клиника Одинцова' },
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'пр. Богатырский, д. 22, к. 1',
    addressLocality: 'Санкт-Петербург',
    postalCode: '197374',
    addressRegion: 'Санкт-Петербург',
    addressCountry: 'RU',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 60.001014,
    longitude: 30.251746,
  },
}

const faqSchema = generateFaqSchema(GYNECOLOGY_FAQ)
---

<Layout
  title="Гинекология в СПб - Клиника Одинцова"
  description="Гинеколог в Приморском районе СПб: осмотр, УЗИ, кольпоскопия и план наблюдения. Клиника Одинцова, м. Комендантский проспект."
  keywords="гинекология Санкт-Петербург, гинеколог Приморский район, УЗИ малого таза, бережный приём, Клиника Одинцова"
  ogImage="/images/og/gynecology.webp"
>
  <script type="application/ld+json" set:html={JSON.stringify(specialtySchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <BreadcrumbNav items={[{ label: 'Гинекология' }]} />
  <Gynecology servicesData={services} client:idle />
</Layout>
