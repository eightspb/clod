---
import Layout from '../layouts/Layout.astro'
import { Nutrition, NUTRITION_FAQ } from '../components/pages/Nutrition.jsx'
import { BreadcrumbNav } from '../components/BreadcrumbNav.jsx'
import { generateFaqSchema } from '../utils/schema.js'

const specialtySchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalClinic',
  name: 'Клиника Одинцова - Нутрициология',
  medicalSpecialty: 'Dietetics',
  availableService: {
    '@type': 'MedicalProcedure',
    name: 'Нутрициология, персональный план питания, коррекция нутритивного статуса',
  },
  isPartOf: { '@type': 'MedicalBusiness', name: 'Клиника Одинцова' },
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'пр. Богатырский, д. 22, к. 1',
    addressLocality: 'Санкт-Петербург',
    postalCode: '197374',
    addressRegion: 'Санкт-Петербург',
    addressCountry: 'RU',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 60.001014,
    longitude: 30.251746,
  },
}

const faqSchema = generateFaqSchema(NUTRITION_FAQ)
---

<Layout
  title="Нутрициология в СПб - Клиника Одинцова"
  description="Нутрициолог в Приморском районе СПб: разбор привычек, анализов и дефицитов, персональный план питания. Клиника Одинцова."
  keywords="нутрициология Санкт-Петербург, нутрициолог Приморский район, персональный план питания, коррекция рациона, Клиника Одинцова"
  ogImage="/images/og/nutrition.webp"
>
  <script type="application/ld+json" set:html={JSON.stringify(specialtySchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <BreadcrumbNav items={[{ label: 'Нутрициология' }]} />
  <Nutrition client:idle />
</Layout>
