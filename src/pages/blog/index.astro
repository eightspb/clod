---
import { getCollection } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import { BreadcrumbNav } from '../../components/BreadcrumbNav.jsx'

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
)

const CATEGORY_SOFT_COLORS = {
  'Маммология':       'clay-card-soft-mint',
  'Диагностика':      'clay-card-soft-blue',
  'Эндокринология':   'clay-card-soft-peach',
  'Гинекология':      'clay-card-soft-lavender',
  'Нутрициология':    'clay-card-soft-lavender',
  'Неврология':       'clay-card-soft-blue',
  'События клиники':  'clay-card-soft-peach',
  'Клинические случаи': 'clay-card-soft-mint',
  'Видео':            'clay-card-soft-blue',
}

const CATEGORY_ACCENT = {
  'Маммология':       'text-emerald-700 bg-emerald-50',
  'Диагностика':      'text-sky-700 bg-sky-50',
  'Эндокринология':   'text-orange-700 bg-orange-50',
  'Гинекология':      'text-violet-700 bg-violet-50',
  'Нутрициология':    'text-violet-700 bg-violet-50',
  'Неврология':       'text-sky-700 bg-sky-50',
  'События клиники':  'text-orange-700 bg-orange-50',
  'Клинические случаи': 'text-emerald-700 bg-emerald-50',
  'Видео':            'text-sky-700 bg-sky-50',
}

const FALLBACK_COLORS = [
  'clay-card-soft-mint',
  'clay-card-soft-peach',
  'clay-card-soft-blue',
  'clay-card-soft-lavender',
]

const ALL_CATEGORIES = ['Все', 'Маммология', 'Гинекология', 'Эндокринология', 'Нутрициология', 'Диагностика', 'События клиники', 'Клинические случаи', 'Видео']

const TV_VIDEOS = [
  {
    title: 'Одинцов о ВАБ на телевидении',
    desc: 'Интервью о вакуумно-аспирационной биопсии — топ-манипуляции клиники',
    channel: 'ТВ-эфир',
    date: '2025',
  },
  {
    title: 'Маммология без мифов',
    desc: 'Врач клиники развенчивает популярные мифы о заболеваниях молочной железы',
    channel: 'ТВ-эфир',
    date: '2025',
  },
]

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Блог Клиники Одинцова',
  description: 'Статьи о маммологии, гинекологии, эндокринологии и нутрициологии от врачей клиники',
  url: 'https://odintsovclinic.ru/blog',
  numberOfItems: posts.length,
  itemListElement: posts.map((post, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: `https://odintsovclinic.ru/blog/${post.slug}`,
    name: post.data.title,
  })),
  publisher: {
    '@type': 'MedicalBusiness',
    name: 'Клиника Одинцова',
    url: 'https://odintsovclinic.ru',
  },
  spatialCoverage: {
    '@type': 'Place',
    name: 'Санкт-Петербург',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Санкт-Петербург',
      addressRegion: 'Санкт-Петербург',
      addressCountry: 'RU',
    },
  },
}
---

<Layout
  title="Блог - статьи о здоровье | Клиника Одинцова"
  description="Полезные статьи о маммологии, гинекологии, эндокринологии и нутрициологии от врачей Клиники Одинцова в Санкт-Петербурге. Советы специалистов, ответы на частые вопросы."
  keywords="блог клиника Одинцова, статьи о маммологии СПб, статьи о гинекологии Санкт-Петербург, статьи о щитовидной железе, советы маммолога СПб, гинеколог СПб, эндокринолог СПб"
  canonicalUrl="https://odintsovclinic.ru/blog"
>
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />

  <BreadcrumbNav items={[{ label: 'Блог' }]} />

  <div class="container-clay pb-20">

    <div class="mb-8">
      <h1 class="text-3xl md:text-4xl font-bold text-clay-text mb-4">
        Блог клиники
      </h1>
      <p class="text-clay-muted text-lg max-w-2xl">
        Статьи, клинические случаи и события от врачей Клиники Одинцова. Разбираем сложные медицинские темы простым языком.
      </p>
    </div>

    {/* Категории */}
    <div class="flex flex-wrap gap-2 mb-10">
      {ALL_CATEGORIES.map((cat) => (
        <span class="inline-flex items-center px-4 py-1.5 rounded-full text-sm font-semibold cursor-pointer transition-colors"
          style="background: rgba(78,200,168,0.1); color: #2BA888; border: 1px solid rgba(78,200,168,0.2);">
          {cat}
        </span>
      ))}
    </div>

    {/* Видео с ТВ */}
    <section class="mb-12">
      <div class="flex items-center gap-3 mb-5">
        <div class="icon-circle-blue">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="23 7 16 12 23 17 23 7"/>
            <rect x="1" y="5" width="15" height="14" rx="2" ry="2"/>
          </svg>
        </div>
        <h2 class="text-xl font-bold text-clay-text">Врачи клиники на телевидении</h2>
      </div>
      <div class="grid gap-5 sm:grid-cols-2">
        {TV_VIDEOS.map((video) => (
          <div class="clay-card-soft-blue clay-card p-6 flex flex-col gap-3">
            <div class="flex items-center gap-2 mb-1">
              <span class="text-xs font-semibold px-2.5 py-1 rounded-full text-sky-700 bg-sky-50">
                {video.channel}
              </span>
              <span class="text-xs text-clay-muted">{video.date}</span>
            </div>
            <div class="w-full aspect-video rounded-2xl flex items-center justify-center" style="background: rgba(78,158,200,0.12);">
              <div class="text-center">
                <div class="w-14 h-14 rounded-full flex items-center justify-center mx-auto mb-3" style="background: rgba(78,158,200,0.2);">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#4E9EC8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="5 3 19 12 5 21 5 3"/>
                  </svg>
                </div>
                <p class="text-xs text-clay-muted">Видео скоро появится</p>
              </div>
            </div>
            <h3 class="font-bold text-clay-text text-sm">{video.title}</h3>
            <p class="text-xs text-clay-muted leading-relaxed">{video.desc}</p>
          </div>
        ))}
      </div>
    </section>

    {/* Статьи */}
    <section class="mb-12">
      <h2 class="text-xl font-bold text-clay-text mb-5">Статьи и клинические случаи</h2>
      {posts.length === 0 ? (
        <p class="text-clay-muted">Статьи скоро появятся.</p>
      ) : (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post, index) => {
            const cardColor = CATEGORY_SOFT_COLORS[post.data.category] ?? FALLBACK_COLORS[index % FALLBACK_COLORS.length]
            const accentClass = CATEGORY_ACCENT[post.data.category] ?? 'text-clay-teal bg-teal-50'
            const formattedDate = post.data.publishDate.toLocaleDateString('ru-RU', {
              day: 'numeric',
              month: 'long',
              year: 'numeric',
            })
            return (
              <a
                href={`/blog/${post.slug}`}
                class={`${cardColor} clay-card flex flex-col p-6 hover:scale-[1.02] transition-transform duration-200 no-underline group`}
              >
                <div class="flex items-center gap-2 mb-4">
                  <span class={`text-xs font-semibold px-2.5 py-1 rounded-full ${accentClass}`}>
                    {post.data.category}
                  </span>
                  {post.data.readingTime && (
                    <span class="text-xs text-clay-muted">{post.data.readingTime} мин</span>
                  )}
                </div>
                <h2 class="text-base font-bold text-clay-dark mb-2 leading-snug line-clamp-3 flex-1">
                  {post.data.title}
                </h2>
                <p class="text-sm text-clay-text mb-5 line-clamp-2 leading-relaxed opacity-80">
                  {post.data.description}
                </p>
                <div class="flex items-center justify-between mt-auto pt-3 border-t border-black/5">
                  <span class="text-xs text-clay-muted">{formattedDate}</span>
                  <span class="text-xs font-semibold text-clay-mint group-hover:translate-x-0.5 transition-transform duration-150">
                    Читать →
                  </span>
                </div>
              </a>
            )
          })}
        </div>
      )}
    </section>

    {/* CTA в личный кабинет */}
    <div class="grid gap-5 sm:grid-cols-2 mb-10">
      <div class="clay-card-soft-mint clay-card p-8 text-center">
        <h2 class="text-xl font-bold text-clay-dark mb-3">Личный кабинет</h2>
        <p class="text-clay-muted mb-6 text-sm leading-relaxed">
          Результаты анализов, история приёмов и запись к врачу — всё в одном месте. Доступно с любого устройства.
        </p>
        <a href="/second-opinion" class="btn-clay-primary inline-flex items-center gap-2">
          Войти в личный кабинет
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
      <div class="clay-card p-8 text-center">
        <h2 class="text-xl font-bold text-clay-dark mb-3">Есть вопрос к врачу?</h2>
        <p class="text-clay-muted mb-6 text-sm leading-relaxed">
          Запишитесь на консультацию — наши специалисты ответят на все вопросы лично в день обращения.
        </p>
        <a href="/second-opinion" class="btn-clay-secondary inline-flex items-center gap-2">
          Записаться на приём
        </a>
      </div>
    </div>

  </div>
</Layout>
