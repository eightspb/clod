---
import Layout from '../layouts/Layout.astro'
import ServiceArticles from '../components/ServiceArticles.astro'
import { Nutrition, NUTRITION_FAQ } from '../components/pages/Nutrition.jsx'
import { BreadcrumbNav } from '../components/BreadcrumbNav.jsx'
import { generateFaqSchema } from '../utils/schema.js'

const specialtySchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': 'https://odintsovclinic.ru/nutrition#service',
  name: 'Консультация нутрициолога в Санкт-Петербурге',
  url: 'https://odintsovclinic.ru/nutrition',
  provider: { '@id': 'https://odintsovclinic.ru/#clinic' },
  areaServed: { '@type': 'City', name: 'Санкт-Петербург' },
}

const faqSchema = generateFaqSchema(NUTRITION_FAQ)
---

<Layout
  pageType="MedicalWebPage"
  title="Нутрициолог в СПб — консультация | Клиника Одинцова"
  description="Консультация нутрициолога в Санкт-Петербурге: разбор рациона, пищевых привычек и персональный план питания. Цены и запись. Приморский район, Богатырский проспект."
  keywords="нутрициология Санкт-Петербург, нутрициолог Приморский район, персональный план питания, коррекция рациона, Клиника Одинцова"
  ogImage="/images/og/nutrition.webp"
>
  <script type="application/ld+json" set:html={JSON.stringify(specialtySchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <BreadcrumbNav items={[{ label: 'Нутрициология' }]} />
  <Nutrition client:idle />
  <ServiceArticles articles={[
    { slug: 'pitaniye-i-gormony', title: 'Питание и гормональный баланс: что есть, чтобы чувствовать себя лучше' },
    { slug: 'pitaniye-pri-spkya', title: 'Питание при СПКЯ: как диета помогает справиться с синдромом поликистозных яичников' },
    { slug: 'metabolicheskoe-zdorovye-i-ves', title: 'Метаболическое здоровье женщины: почему вес — это не только калории' },
  ]} />
</Layout>
